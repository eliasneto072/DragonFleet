# ─── Base de dados ────────────────────────────────────────────────────────────
POSTGRES_USER=dragonfleet
POSTGRES_PASSWORD=            # gere uma: openssl rand -base64 24
POSTGRES_DB=dragonfleet
DATABASE_URL=postgresql://dragonfleet:SENHA@postgres:5432/dragonfleet?schema=public

# ─── Ambiente ─────────────────────────────────────────────────────────────────
# 'production' aperta as verificações: exige os segredos abaixo, exige o CORS,
# e faz o upload rebentar sem Cloudinary em vez de fingir que guardou.
NODE_ENV=development
PORT=3000

# ─── Segredos ─────────────────────────────────────────────────────────────────
# OBRIGATÓRIOS em produção. O servidor recusa arrancar sem eles, e recusa
# também os que contenham "change-me" ou tenham menos de 32 caracteres.
#
#   openssl rand -base64 48
#
# Os dois têm de ser DIFERENTES: o de refresh vive sete dias e o de acesso
# quinze minutos. Partilhá-los faz um token curto poder ser usado como longo.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Endereços do frontend, separados por vírgula. OBRIGATÓRIO em produção.
# Vazio em desenvolvimento aceita qualquer origem, que é o que se quer numa
# máquina local com a extensão a chamar de um chrome-extension://
CORS_ORIGINS=

# ─── Cloudinary ───────────────────────────────────────────────────────────────
# Sem estes, os ficheiros NÃO são guardados: fora de produção o upload devolve
# uma referência fictícia e regista um aviso; em produção recusa arrancar.
CLOUD_NAME=
API_KEY=
API_SECRET=

# ─── Email ────────────────────────────────────────────────────────────────────
# Sem a chave, os emails são registados em vez de enviados.
RESEND_API_KEY=
MAIL_FROM=
