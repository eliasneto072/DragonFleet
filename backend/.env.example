# ─────────────────────────────────────────────────────────────
# DragonFleet — Backend environment (EXEMPLO)
# Copie para .env e preencha. NUNCA versionar o .env real.
# ─────────────────────────────────────────────────────────────

# Base de dados (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/dragonfleet"
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# JWT — gere segredos fortes:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN="7d"
JWT_ISSUER="dragonfleet"
JWT_AUDIENCE="dragonfleet-app"

# Cloudinary (armazenamento de documentos)
CLOUD_NAME=
API_KEY=
API_SECRET=

# AWS S3 / R2 (opcional — migração futura de armazenamento)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Email (Resend) — ver docs/EMAIL_SETUP.md
RESEND_API_KEY=
# Remetente: use um domínio verificado na Resend para enviar a motoristas reais.
# onboarding@resend.dev só entrega para o email da sua própria conta Resend.
MAIL_FROM="DragonFleet <onboarding@resend.dev>"

# URL do frontend (usada nos links dos emails)
FRONTEND_URL="http://localhost:5173"

# Seed do admin inicial (usado por: npm run seed:admin)
# A password deve ter pelo menos 8 caracteres.
SEED_ADMIN_EMAIL="admin@dragonfleet.com"
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME="Administrador"

# Porta do servidor
PORT="3000"

# Ambiente
NODE_ENV="development"
