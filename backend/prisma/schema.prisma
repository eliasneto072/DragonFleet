// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/* =========================
   ENUMS
   ========================= */

enum UserRole {
  ADMIN
  DRIVER
  MANAGER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  AGUARDANDO_REGULARIZACAO
}

enum DocumentType {
  // Documentos do motorista (pessoais)
  CARTAO_CIDADAO
  REGISTO_CRIMINAL
  CARTA_CONDUCAO
  CERTIFICADO_TVDE
  FOTO_PERFIL

  // Documentos do veículo
  DUA
  SEGURO_CARTA_VERDE
  SEGURO_CONDICOES_ESPECIAIS
  INSPECAO_PERIODICA

  OTHER
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum VehicleStatus {
  PENDING
  ACTIVE
  INACTIVE
  MAINTENANCE
  SOLD
}

enum EarningPlatform {
  UBER
  BOLT
  FREE_NOW
  OTHER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketCategory {
  TECHNICAL
  FINANCIAL
  DOCUMENTS
  ACCOUNT
  OTHER
}

enum AdjustmentType {
  CREDIT
  DEBIT
}

/* =========================
   MODELS
   ========================= */

model User {
  id        String     @id @default(cuid())
  name      String
  email     String     @unique
  password  String
  role      UserRole   @default(DRIVER)
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt

  earnings           Earning[]
  vehicles           Vehicle[]
  notifications      Notification[]
  documents          Document[]
  withdrawals        Withdrawal[]
  supportTickets     SupportTicket[]
  ticketReplies      TicketReply[]
  vehicleAssignments VehicleAssignment[]
  balanceAdjustments BalanceAdjustment[] @relation("adjustmentsReceived")
  adjustmentsMade    BalanceAdjustment[] @relation("adjustmentsMade")

  @@map("users")
}

model Earning {
  id        String          @id @default(cuid())
  amount    Decimal         @db.Decimal(12, 2)
  date      DateTime        @db.Date
  platform  EarningPlatform
  userId    String          @map("user_id")
  createdAt DateTime        @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([date])
  @@map("earnings")
}

model Vehicle {
  id               String        @id @default(cuid())
  brand            String
  model            String
  plate            String        @unique
  year             Int
  vin              String?       @unique
  status           VehicleStatus @default(PENDING)
  activationForced Boolean       @default(false) @map("activation_forced")
  userId           String?       @map("user_id")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt

  user        User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  documents   Document[]
  assignments VehicleAssignment[]

  @@index([userId])
  @@index([status])
  @@map("vehicles")
}

model VehicleAssignment {
  id        String    @id @default(cuid())
  vehicleId String    @map("vehicle_id")
  userId    String?   @map("user_id")
  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([vehicleId])
  @@index([userId])
  @@map("vehicle_assignments")
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  userId    String   @map("user_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@map("notifications")
}

model Document {
  id      String         @id @default(cuid())
  type    DocumentType
  fileUrl String         @map("file_url")
  fileKey String         @map("file_key")
  notes   String?
  status  DocumentStatus @default(PENDING)

  // Controlo de validade (usado pelo Registo Criminal: 90 dias a partir da emissão).
  issuedAt  DateTime? @map("issued_at")
  expiresAt DateTime? @map("expires_at")

  userId    String   @map("user_id")
  vehicleId String?  @map("vehicle_id") // vazio = documento pessoal; preenchido = documento do veículo
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([vehicleId])
  @@index([type, status])
  @@index([status, expiresAt])
  @@map("documents")
}

model Withdrawal {
  id          String           @id @default(cuid())
  amount      Decimal          @db.Decimal(12, 2)
  status      WithdrawalStatus @default(PENDING)
  notes       String?
  requestedAt DateTime         @default(now()) @map("requested_at")
  processedAt DateTime?        @map("processed_at")
  userId      String           @map("user_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("withdrawals")
}

model BalanceAdjustment {
  id        String         @id @default(cuid())
  amount    Decimal        @db.Decimal(12, 2) // sempre positivo; o sinal vem do type
  type      AdjustmentType
  reason    String
  userId    String         @map("user_id")
  createdBy String?        @map("created_by") // admin que fez o ajuste (auditoria)
  createdAt DateTime       @default(now()) @map("created_at")

  user  User  @relation("adjustmentsReceived", fields: [userId], references: [id], onDelete: Cascade)
  admin User? @relation("adjustmentsMade", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("balance_adjustments")
}

model SupportTicket {
  id        String         @id @default(cuid())
  subject   String
  category  TicketCategory
  message   String
  status    TicketStatus   @default(OPEN)
  userId    String         @map("user_id")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies TicketReply[]

  @@index([userId])
  @@index([status])
  @@map("support_tickets")
}

model TicketReply {
  id        String   @id @default(cuid())
  message   String
  ticketId  String   @map("ticket_id")
  authorId  String   @map("author_id")
  createdAt DateTime @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("ticket_replies")
}

model SystemSettings {
  id                        String   @id @default("global")
  companyCommission         Int      @default(15) // %
  minWithdrawalAmount       Int      @default(50) // €
  maxWithdrawalAmount       Int      @default(5000) // €
  withdrawalProcessingDays  Int      @default(1)
  documentExpiryWarningDays Int      @default(30)
  uberIntegration           Boolean  @default(true)
  boltIntegration           Boolean  @default(true)
  emailNotifications        Boolean  @default(true)
  smsNotifications          Boolean  @default(false)
  autoApproveDocuments      Boolean  @default(false)
  requireTwoFactorAuth      Boolean  @default(false)
  updatedAt                 DateTime @updatedAt
  updatedBy                 String?  @map("updated_by")

  @@map("system_settings")
}