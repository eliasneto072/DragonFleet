// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/* =========================
   ENUMS
   ========================= */

enum UserRole {
  ADMIN
  DRIVER
  MANAGER

  /// Vê o que precisa para responder a um ticket; não mexe em dinheiro.
  ///
  /// Existe porque a pergunta número um do suporte de uma frota é "onde está o
  /// meu dinheiro", e quem não consegue ver retiradas, fechos e documentos tem
  /// de ir perguntar à administração — o que não poupa trabalho a ninguém, só
  /// acrescenta um passo.
  SUPPORT

  /// Investidor: entra pelo invest.dragonfleet.pt e não vê nada da frota.
  ///
  /// O bloqueio não é a interface esconder menus — é o servidor recusar tudo o
  /// que não seja o portal dele (ver `deny-investor.middleware.ts`). Uma conta
  /// destas não é um motorista com menos botões: é alguém de fora da empresa.
  INVESTOR

  /// Mecânico: entra para ver e confirmar as marcações da oficina DELE.
  ///
  /// Como o investidor, é alguém de fora da empresa — e o bloqueio é o mesmo:
  /// o servidor recusa tudo o que não seja o portal da oficina (ver
  /// `deny-mechanic.middleware.ts`). Não vê fechos, saldos, motoristas nem
  /// documentos; vê os carros que lhe mandam e as datas.
  MECHANIC
}

/// Em que ponto está uma marcação de oficina.
///
/// ─── PORQUE É QUE HÁ UM ESTADO SÓ PARA A CONTRAPROPOSTA ────────────────────
///
/// `NOVA_DATA_PROPOSTA` existe porque a alternativa é a oficina mudar a data e
/// pronto — e aí quem pediu descobre que o carro é para entregar noutro dia
/// quando abrir o ecrã, ou pior, quando lá chegar. Com um estado próprio, a
/// marcação fica parada à espera de alguém aceitar, e ninguém assume uma hora
/// que não combinou.
enum BookingStatus {
  PENDENTE
  NOVA_DATA_PROPOSTA
  CONFIRMADA
  CONCLUIDA
  CANCELADA
  RECUSADA
}

/// Quem leva o carro à oficina.
///
/// O motorista que marca por iniciativa própria leva sempre o carro — foi o
/// que o cliente pediu, e é o que faz sentido: o carro está com ele. As outras
/// duas só a gestão pode escolher.
enum BookingLogistics {
  MOTORISTA_LEVA
  OFICINA_RECOLHE
  EMPRESA_LEVA
}

/// O que é cada ficheiro anexado a uma marcação.
///
/// Separados e não um monte de ficheiros soltos porque a pergunta que se faz
/// meses depois é "onde está o comprovativo daquele pagamento", e não "quantos
/// ficheiros tinha aquela reparação".
enum BookingFileKind {
  FATURA
  COMPROVATIVO
  OUTRO
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  AGUARDANDO_REGULARIZACAO
}

enum DocumentType {
  // Documentos do motorista (pessoais)
  CARTAO_CIDADAO
  REGISTO_CRIMINAL
  CARTA_CONDUCAO
  CERTIFICADO_TVDE
  FOTO_PERFIL
  /// Comprovativo de titularidade da conta bancária.
  COMPROVATIVO_IBAN

  // Documentos do veículo
  DUA
  SEGURO_CARTA_VERDE
  SEGURO_CONDICOES_ESPECIAIS
  INSPECAO_PERIODICA

  OTHER
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum VehicleStatus {
  PENDING
  ACTIVE
  INACTIVE
  MAINTENANCE
  SOLD
}

enum EarningStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EarningPlatform {
  UBER
  BOLT
  FREE_NOW
  OTHER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketCategory {
  TECHNICAL
  FINANCIAL
  DOCUMENTS
  ACCOUNT
  OTHER
}

enum AdjustmentType {
  CREDIT
  DEBIT
}

/// De quanto em quanto tempo um pagamento agendado se repete.
///
/// `UNICO` existe porque metade das vezes o que se quer agendar NÃO se repete:
/// uma caução a devolver no dia 30, um prémio combinado para o fim do mês.
/// Sem ele, essas pessoas criavam um mensal e lembravam-se de o desligar —
/// ou não se lembravam, e o motorista era descontado para sempre.
enum PaymentFrequency {
  UNICO
  SEMANAL
  QUINZENAL
  MENSAL
  TRIMESTRAL
  SEMESTRAL
  ANUAL
}

/* =========================
   MODELS
   ========================= */

model User {
  id        String     @id @default(cuid())

  /// A frota a que isto pertence. Ver `escopo.ts`: nenhuma consulta sai
  /// daqui sem esta coluna preenchida.
  ///
  /// Tem relação declarada para `Fleet` — tal como `Invite`, e só essas duas.
  /// São as duas que o código percorre: o middleware do âmbito precisa do nome
  /// da frota e de saber se está ligada, e um convite precisa de dizer em que
  /// empresa é que a pessoa está a entrar. As outras quarenta ficam com a
  /// coluna e a chave estrangeira na base de dados — quarenta listas inversas
  /// aqui não serviam ninguém e deixavam o ficheiro ilegível.
  fleetId String @default("") @map("fleet_id")
  fleet   Fleet  @relation(fields: [fleetId], references: [id])
  name      String
  email     String     @unique
  password  String

  /// É o dono da PLATAFORMA, e não de uma frota.
  ///
  /// Não é um papel: é uma marca por cima do papel que ele já tem. O dono
  /// continua a ser o administrador da frota dele e a trabalhar nela todos os
  /// dias; isto só lhe abre o painel de sistema e o botão que troca entre os
  /// dois. Feito como papel, obrigava-o a ter duas contas e dois emails para
  /// fazer o trabalho que faz hoje com uma.
  isOwner   Boolean    @default(false) @map("is_owner")

  /// Contacto telefónico, preenchido pelo próprio no perfil.
  ///
  /// Opcional e sem `@unique`. Opcional porque nenhum registo existente o tem e
  /// tornar obrigatório trancava a conta de toda a gente no próximo arranque.
  /// Sem `@unique` porque um casal que partilhe um número não é uma anomalia
  /// que valha a pena impedir — e um índice único aqui rejeitaria o segundo com
  /// uma mensagem que ninguém saberia explicar.
  ///
  /// Guardado normalizado (`+` opcional seguido de dígitos, ver
  /// `shared/utils/phone.ts`). O email continua a ser o contacto principal:
  /// isto serve para ligar a alguém por causa de uma multa ou de um acidente.
  phone     String?

  /// Tem a página de finanças pessoais: o diário de trading e as despesas.
  ///
  /// ─── PORQUE É UMA MARCA E NÃO UM EMAIL NO CÓDIGO ──────────────────────────
  ///
  /// Porque um email escrito numa condição fica publicado no repositório,
  /// deixa de funcionar no dia em que a pessoa o mudar — sem dizer nada, que é
  /// o pior modo de avariar — e obriga a mexer no programa para ligar a mesma
  /// coisa noutra conta.
  ///
  /// Desligada em toda a gente, incluindo em quem for criado a seguir. Só o
  /// dono da plataforma a liga, e liga-a conta a conta. É a mesma escolha do
  /// `isOwner` logo acima, pelas mesmas razões.
  personalFinance Boolean @default(false) @map("personal_finance")

  /// Este motorista É a empresa (o dono, que também conduz).
  ///
  /// Muda como as estatísticas o contam: o aluguer da viatura que lhe é
  /// lançado é a empresa a cobrar a si própria e NÃO entra no lucro; o que ele
  /// fecha na semana entra por inteiro. Marca e não um nome no código, para
  /// poderem ser vários e para não se partir quando um nome muda.
  isCompany Boolean @default(false) @map("is_company")

  role      UserRole   @default(DRIVER)
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt

  earnings           Earning[]
  vehicles           Vehicle[]
  notifications      Notification[]
  documents          Document[]
  withdrawals        Withdrawal[]
  supportTickets     SupportTicket[]
  ticketReplies      TicketReply[]
  vehicleAssignments VehicleAssignment[]
  balanceAdjustments BalanceAdjustment[] @relation("adjustmentsReceived")
  adjustmentsMade    BalanceAdjustment[] @relation("adjustmentsMade")
  adjustmentsEdited  BalanceAdjustment[] @relation("adjustmentsEdited")
  settlements        WeeklySettlement[]  @relation("settlementsReceived")
  settlementsCreated WeeklySettlement[]  @relation("settlementsCreated")
  settlementRevisions SettlementRevision[] @relation("settlementRevisions")
  scheduledPaymentsReceived ScheduledPayment[] @relation("scheduledPaymentsReceived")
  scheduledPaymentsCreated  ScheduledPayment[] @relation("scheduledPaymentsCreated")
  remindersOwned            Reminder[]         @relation("remindersOwned")

  /// A oficina de um MECHANIC. Nulo em todos os outros perfis.
  ///
  /// É isto que faz o mecânico ver só as marcações da oficina dele. Um
  /// MECHANIC sem oficina não vê nada — e isso é de propósito: vale mais uma
  /// conta que não mostra nada do que uma que mostra a frota toda.
  workshopId String?   @map("workshop_id")
  workshop   Workshop? @relation("workshopStaff", fields: [workshopId], references: [id], onDelete: SetNull)

  bookingsRequested Booking[] @relation("bookingsRequested")
  bookingsForDriver Booking[] @relation("bookingsForDriver")
  bookingsEscorted  Booking[] @relation("bookingsEscorted")
  bookingFiles      BookingFile[] @relation("bookingFilesUploaded")
  stockMovesCreated    StockMove[] @relation("stockMovesCreated")
  stockMovesForDriver  StockMove[] @relation("stockMovesForDriver")
  earningsReviewed   Earning[]           @relation("earningsReviewed")
  bankAccounts       BankAccount[]
  bankAccountsReviewed BankAccount[]     @relation("bankAccountsReviewed")
  investments        Investment[]
  rank               DriverRank?
  rankEvents         RankEvent[]
  investorAccount    InvestorAccount?
  permissions        StaffPermission[]
  trades             TradeEntry[]
  personalExpenses   PersonalExpense[]
  expenseCategories  PersonalExpenseCategory[]
  credits            Credit[]
  companyExpenses    CompanyExpense[]  @relation("companyExpensesCreated")
  cashMarks          CompanyCashMark[] @relation("cashMarksCreated")
  settlementQueries  SettlementQuery[] @relation("queriesAsked")
  queriesAnswered    SettlementQuery[] @relation("queriesAnswered")
  statementAccounts  StatementAccount[] @relation("statementAccountOwner")
  statementsImported StatementFile[]    @relation("statementsImported")

  @@index([fleetId])

  @@map("users")
}

// Lançamento comunicado pelo motorista.
//
// NÃO movimenta saldo. O dinheiro entra por uma porta só — o fecho semanal.
// Isto aqui é o que o motorista diz ter feito, e serve de conferência cruzada
// quando a administração fecha a semana: se o relatório da Uber disser 109 € e
// o motorista tiver comunicado 119 €, alguém olha antes de fechar.
//
// Se estes valores também creditassem, o mesmo dinheiro entraria por dois
// caminhos e o motorista seria pago duas vezes pela mesma semana.
model Earning {
  id        String          @id @default(cuid())

  /// A frota a que isto pertence. Ver `escopo.ts`: nenhuma consulta sai
  /// daqui sem esta coluna preenchida.
  fleetId String @default("") @map("fleet_id")
  amount    Decimal         @db.Decimal(12, 2)
  date      DateTime        @db.Date
  platform  EarningPlatform
  status    EarningStatus   @default(PENDING)
  /// Justificação do motorista, ou motivo da recusa.
  notes     String?
  userId    String          @map("user_id")

  reviewedById String?   @map("reviewed_by_id")
  reviewedAt   DateTime? @map("reviewed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("earningsReviewed", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([date])
  @@index([status])
  @@index([fleetId])
  @@map("earnings")
}

/// Combustível, elétrico ou híbrido.
///
/// Três valores e não um `isElectric`: um booleano obrigava a decidir hoje o
/// que fazer com um híbrido, e qualquer resposta escondia metade do gasto.
enum VehicleEnergy {
  FUEL
  ELECTRIC
  HYBRID
}

model Vehicle {
  id               String        @id @default(cuid())

  /// A frota a que isto pertence. Ver `escopo.ts`: nenhuma consulta sai
  /// daqui sem esta coluna preenchida.
  fleetId String @default("") @map("fleet_id")
  brand            String
  model            String
  plate            String
  year             Int
  vin              String?
  status           VehicleStatus @default(PENDING)

  /// Decide o RÓTULO do campo de despesa no fecho (Combustível ou
  /// Carregamento) e separa os gastos nas estatísticas. A coluna do dinheiro
  /// continua a ser uma só — ver a migração.
  energyType       VehicleEnergy @default(FUEL) @map("energy_type")
  activationForced Boolean       @default(false) @map("activation_forced")

  /// Encargo semanal da viatura, usado como valor sugerido no fecho semanal.
  /// Fica aqui e não no fecho porque é uma característica do carro; o fecho
  /// grava a sua própria cópia, para que alterar isto não reescreva semanas
  /// já pagas.
  weeklyFee        Decimal       @default(0) @map("weekly_fee") @db.Decimal(12, 2)
  userId           String?       @map("user_id")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt

  /// Quando caduca a inspeção periódica deste carro.
  ///
  /// Guardada aqui e não deduzida da última inspeção feita: um carro pode
  /// entrar na frota já inspecionado, e a data vem do papel. Nula enquanto
  /// ninguém a escrever — e nula NÃO é "está em dia", é "não se sabe", que é
  /// o que o aviso diz.
  nextInspectionOn DateTime? @map("next_inspection_on") @db.Date

  user        User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  documents   Document[]
  bookings    Booking[]
  stockMoves  StockMove[]         @relation("stockMovesForVehicle")
  assignments VehicleAssignment[]
  settlements WeeklySettlement[]
  projects    InvestmentProject[]

  // A matrícula é única DENTRO da frota e não no sistema inteiro.
  // Globalmente única parecia mais correto — um carro só está numa frota —
  // mas dizia a uma frota que a matrícula já existia noutra, que é
  // informação de um cliente a chegar a outro. E impedia o caso real de um
  // carro vendido de uma frota para outra, com a primeira a guardar o
  // histórico dele.
  @@unique([fleetId, plate])
  @@unique([fleetId, vin])
  @@index([userId])
  @@index([status])
  @@index([fleetId])
  @@map("vehicles")
}

model VehicleAssignment {
  id        String    @id @default(cuid())

  /// A frota a que isto pertence. Ver `escopo.ts`: nenhuma consulta sai
  /// daqui sem esta coluna preenchida.
  fleetId String @default("") @map("fleet_id")
  vehicleId String    @map("vehicle_id")
  userId    String?   @map("user_id")
  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([vehicleId])
  @@index([userId])
  @@index([fleetId])
  @@map("vehicle_assignments")
}

model Notification {
  id        String   @id @default(cuid())

  /// A frota a que isto pertence. Ver `escopo.ts`: nenhuma consulta sai
  /// daqui sem esta coluna preenchida.
  fleetId String @default("") @map("fleet_id")
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  userId    String   @map("user_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([fleetId])
  @@map("notifications")
}

model Document {
  id      String         @id @default(cuid())

  /// A frota a que isto pertence. Ver `escopo.ts`: nenhuma consulta sai
  /// daqui sem esta coluna preenchida.
  fleetId String @default("") @map("fleet_id")
  type    DocumentType
  fileUrl String         @map("file_url")
  fileKey String         @map("file_key")
  notes   String?
  status  DocumentStatus @default(PENDING)

  // Controlo de validade (usado pelo Registo Criminal: 90 dias a partir da emissão).
  issuedAt  DateTime? @map("issued_at")
  expiresAt DateTime? @map("expires_at")

  userId    String   @map("user_id")
  vehicleId String?  @map("vehicle_id") // vazio = documento pessoal; preenchido = documento do veículo
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([vehicleId])
  @@index([type, status])
  @@index([status, expiresAt])
  @@index([fleetId])
  @@map("documents")
}

model Withdrawal {
  id          String           @id @default(cuid())

  /// A frota a que isto pertence. Ver `escopo.ts`: nenhuma consulta sai
  /// daqui sem esta coluna preenchida.
  fleetId String @default("") @map("fleet_id")
  amount      Decimal          @db.Decimal(12, 2)
  status      WithdrawalStatus @default(PENDING)
  notes       String?
  requestedAt DateTime         @default(now()) @map("requested_at")
  processedAt DateTime?        @map("processed_at")
  userId      String           @map("user_id")

  /// Recibo verde, anexado no momento do pedido. Obrigatório: a empresa não
  /// paga sem fatura, e exigir depois da aprovação deixaria pedidos aprovados
  /// à espera de um documento que ninguém lembra de pedir.
  receiptUrl String @map("receipt_url")
  receiptKey String @map("receipt_key")

  /// A conta escolhida pelo motorista ao pedir. Serve para a tela do
  /// administrador mostrar o nome que ele lhe deu em vez do número, e para se
  /// saber qual das três foi pedida mesmo que depois seja arquivada.
  ///
  /// Nula nas retiradas anteriores a esta funcionalidade — nessas havia uma
  /// conta só e não havia escolha nenhuma a registar.
  bankAccountId String?      @map("bank_account_id")
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)

  /// IBAN para onde o valor foi enviado, copiado no momento da APROVAÇÃO.
  ///
  /// Congelado de propósito, como a percentagem no fecho semanal: se o
  /// motorista alterar os dados bancários depois, uma retirada já decidida não
  /// pode mudar de destino sem ninguém reparar.
  paidToIban   String?   @map("paid_to_iban")
  paidToHolder String?   @map("paid_to_holder")

  // ── A quem foi emitido o recibo verde ──────────────────────────────────────
  //
  // Registado no momento da aprovação. Serve a contabilidade: um operador com
  // várias sociedades tem de saber que entidade recebeu que fatura.
  //
  // DUAS colunas porque a escolha tem duas naturezas: uma sociedade da lista,
  // ou texto livre para o que não esteja lá. "Nenhum" é ambas nulas — e é
  // diferente de "por classificar", que são as retiradas anteriores a este
  // campo, distinguidas por companySetAt nulo.
  //
  // SetNull e não Cascade: apagar uma sociedade não pode apagar retiradas.
  companyId    String?   @map("company_id")
  company      Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyOther String?   @map("company_other")

  // Quem classificou e quando. Ao contrário do IBAN, este campo é corrigível:
  // não entra em cálculo nenhum, é uma anotação contabilística, e um clique
  // errado no dropdown não deve obrigar a rejeitar a retirada. Corrigível com
  // rasto é melhor do que imutável.
  companySetById String?   @map("company_set_by_id")
  companySetAt   DateTime? @map("company_set_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  // A tela de Recibos Verdes agrupa e soma por sociedade, e o cartao das
  // sociedades conta os recibos de cada uma. Sem este indice, cada uma dessas
  // consultas e um varrimento sequencial da tabela toda.
  @@index([companyId])
  @@index([bankAccountId])
  @@index([fleetId])
  @@map("withdrawals")
}

/// Dados bancários do motorista.
///
/// Alterações passam por aprovação: trocar o IBAN é o vetor clássico de
/// fraude — quem ganhe acesso à conta muda o número e desvia o pagamento
/// seguinte. Enquanto a alteração está pendente, o IBAN anterior continua a
/// valer, por isso os dois pares de campos coexistem.
/// Uma conta bancária do motorista. Até três por pessoa.
///
/// Cada uma tem o seu ciclo de aprovação: submete-se com comprovativo, fica
/// pendente, e só depois de aprovada pode receber dinheiro. Três contas são
/// três aprovações — a confiança é por conta, não por pessoa.
model BankAccount {
  id     String @id @default(cuid())

  /// A frota a que isto pertence. Ver `escopo.ts`: nenhuma consulta sai
  /// daqui sem esta coluna preenchida.
  fleetId String @default("") @map("fleet_id")
  userId String @map("user_id")

  /// O nome que o motorista dá à conta ("Millennium", "conta da empresa").
  /// Sem isto, escolher entre três IBANs é escolher entre três filas de
  /// dígitos.
  label String?

  /// A que vem escolhida por omissão no pedido de retirada.
  /// Um índice parcial na base garante que só há uma ativa por motorista.
  isPrimary Boolean @default(false) @map("is_primary")

  /// Arquivada. Não se apaga: retiradas antigas apontam para cá.
  archivedAt DateTime? @map("archived_at")

  /// Em vigor. Vazio até a primeira aprovação.
  iban       String?
  holderName String? @map("holder_name")

  /// Submetido e à espera de decisão.
  pendingIban       String? @map("pending_iban")
  pendingHolderName String? @map("pending_holder_name")
  /// Comprovativo que acompanha a alteração pendente.
  pendingProofUrl   String? @map("pending_proof_url")
  pendingProofKey   String? @map("pending_proof_key")
  pendingAt         DateTime? @map("pending_at")

  /// Motivo, quando a alteração é recusada.
  rejectionReason String? @map("rejection_reason")

  reviewedById String?   @map("reviewed_by_id")
  reviewedAt   DateTime? @map("reviewed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy  User?        @relation("bankAccountsReviewed", fields: [reviewedById], references: [id], onDelete: SetNull)
  withdrawals Withdrawal[]

  @@index([userId])
  @@index([fleetId])
  @@map("bank_accounts")
}

model BalanceAdjustment {
  id        String         @id @default(cuid())

  /// A frota a que isto pertence. Ver `escopo.ts`: nenhuma consulta sai
  /// daqui sem esta coluna preenchida.
  fleetId String @default("") @map("fleet_id")
  amount    Decimal        @db.Decimal(12, 2) // sempre positivo; o sinal vem do type
  type      AdjustmentType
  reason    String
  userId    String         @map("user_id")
  createdBy String?        @map("created_by") // admin que fez o ajuste (auditoria)

  /// A data do movimento. É esta que ancora a linha no extrato e, portanto,
  /// decide os saldos corridos. Pode ser corrigida pelo painel — daí o rasto
  /// de edição abaixo.
  createdAt DateTime       @default(now()) @map("created_at")

  /// Nulos enquanto nunca foi editado, que é o que se quer dizer.
  editedAt DateTime? @map("edited_at")
  editedBy String?   @map("edited_by")

  user   User  @relation("adjustmentsReceived", fields: [userId], references: [id], onDelete: Cascade)
  admin  User? @relation("adjustmentsMade", fields: [createdBy], references: [id], onDelete: SetNull)
  editor User? @relation("adjustmentsEdited", fields: [editedBy], references: [id], onDelete: SetNull)

  /// A despesa pessoal que escreveu este débito, quando foi uma.
  ///
  /// A esmagadora maioria dos ajustes não tem nenhuma: são lançamentos da
  /// administração. Isto existe para a despesa e o seu débito poderem ser
  /// alterados juntos — e para ninguém ter de adivinhar, olhando para o
  /// extrato, de onde veio uma linha que diz só «Despesa pessoal».
  personalExpense PersonalExpense?

  @@index([userId])
  @@index([fleetId])
  @@map("balance_adjustments")
}

/// Um tipo de pagamento, para a lista do formulário.
///
/// ─── PORQUE É QUE ISTO É UMA TABELA E NÃO UM enum ──────────────────────────
///
/// Porque o cliente pediu que fosse ele a acrescentar: "um dropbox e editavel,
/// eu posso adiconar coisas que me lembre". Um enum do Prisma precisa de uma
/// migração e de um deploy para ganhar um valor novo — ou seja, precisa de mim.
/// Numa tabela, ele escreve "Seguro de saúde" e usa-o no minuto seguinte.
///
/// O nome do tipo NÃO é o que o motorista vê. O que ele lê é a descrição
/// escrita no agendamento, que é livre. Isto serve para agrupar e para o
/// formulário não começar numa caixa de texto vazia.
model PaymentCategory {
  id        String   @id @default(cuid())

  /// A frota a que isto pertence. Ver `escopo.ts`: nenhuma consulta sai
  /// daqui sem esta coluna preenchida.
  fleetId String @default("") @map("fleet_id")
  label     String
  /// Desligada em vez de apagada: os agendamentos antigos continuam a
  /// apontar para ela, e apagá-la deixaria o histórico a falar de um tipo que
  /// já não existe.
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  payments ScheduledPayment[]

  @@unique([fleetId, label])
  @@index([fleetId])

  @@map("payment_categories")
}

/// Um pagamento que entra ou sai do saldo de um motorista, sozinho, numa data.
///
/// ─── O QUE ISTO NÃO É ───────────────────────────────────────────────────────
///
/// Não é um movimento. É a REGRA que fabrica movimentos. Quando chega a data, o
/// job cria um `BalanceAdjustment` normal — exatamente igual ao que sairia de
/// alguém o lançar à mão, com a mesma descrição e o mesmo sentido.
///
/// Foi pedido assim de propósito: "aparece esse movimento ao motorista como se
/// fosse manual". E é a decisão certa por mais do que gosto — o extrato, o
/// saldo, os relatórios e o recibo já sabem ler ajustes manuais. Um tipo novo
/// de movimento obrigaria a ensinar-lhes a todos, e algum ficaria por ensinar.
///
/// ─── PORQUE É QUE GUARDA A PRÓXIMA DATA EM VEZ DE A CALCULAR ────────────────
///
/// `nextRunOn` é escrita e não deduzida da data de início mais o intervalo.
/// Deduzir parece mais limpo até ao dia em que o servidor está em baixo e falha
/// uma execução: a conta diria que a próxima é daqui a um mês e o mês saltado
/// desaparecia sem nada a dizê-lo. Escrita, a data fica para trás, o job vê-a
/// vencida, e paga o que ficou por pagar.
model ScheduledPayment {
  id          String           @id @default(cuid())

  /// A frota a que isto pertence. Ver `escopo.ts`: nenhuma consulta sai
  /// daqui sem esta coluna preenchida.
  fleetId String @default("") @map("fleet_id")
  userId      String           @map("user_id")
  type        AdjustmentType
  amount      Decimal          @db.Decimal(12, 2)
  /// O que o motorista vai ler no extrato. Livre, como o motivo de um manual.
  description String
  categoryId  String?          @map("category_id")

  frequency PaymentFrequency

  /// A data do primeiro lançamento, e a data do próximo.
  startsOn  DateTime  @map("starts_on")  @db.Date
  nextRunOn DateTime? @map("next_run_on") @db.Date

  /// O fim, opcional e de duas formas. Nulos os dois = corre até ser parado.
  ///
  /// `remaining` conta para baixo a cada lançamento. Serve para "esta multa em
  /// 6 prestações", que é como as pessoas pensam — ninguém calcula a data do
  /// sexto mês de cabeça.
  endsOn    DateTime? @map("ends_on") @db.Date
  remaining Int?

  /// Desligado à mão. Separado de `endsOn` porque são coisas diferentes: um
  /// acabou, o outro foi interrompido.
  active Boolean @default(true)

  /// Quantos lançamentos já fez, e quando foi o último. Para o ecrã poder
  /// mostrar "3 de 6, o último a 12/09".
  runCount  Int       @default(0) @map("run_count")
  lastRunAt DateTime? @map("last_run_at")

  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt      @map("updated_at")

  user      User             @relation("scheduledPaymentsReceived", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User             @relation("scheduledPaymentsCreated", fields: [createdById], references: [id])
  category  PaymentCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId])
  // O job pergunta sempre a mesma coisa: quais os activos com data vencida.
  @@index([active, nextRunOn])
  @@index([fleetId])
  @@map("scheduled_payments")
}

/// Um lembrete que insiste até alguém o dar por feito.
///
/// ─── PORQUE É QUE INSISTE ───────────────────────────────────────────────────
///
/// Porque foi o ponto do pedido: "ele vai mandando notificação desse lembrete,
/// até eu carregar no concluir". Um lembrete que avisa uma vez é um alarme que
/// se perde entre as outras notificações do dia. Um que volta todos os dias é
/// uma lista de coisas por fazer que se esvazia sozinha quando se fazem.
///
/// `lastNotifiedOn` guarda o DIA e não o instante: é o que garante uma
/// notificação por dia mesmo que o job corra duas vezes — um reinício do
/// servidor, um deploy a meio da manhã.
model Reminder {
  id    String  @id @default(cuid())

  /// A frota a que isto pertence. Ver `escopo.ts`: nenhuma consulta sai
  /// daqui sem esta coluna preenchida.
  fleetId String @default("") @map("fleet_id")
  title String
  notes String?

  /// A partir de que dia começa a avisar. Hoje, por omissão.
  dueOn DateTime @map("due_on") @db.Date

  /// Quem recebe os avisos. É também quem o criou, mas fica em campo próprio
  /// para um dia se poder lembrar outra pessoa sem mexer na tabela.
  ownerId String @map("owner_id")

  doneAt         DateTime? @map("done_at")
  lastNotifiedOn DateTime? @map("last_notified_on") @db.Date

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  owner User @relation("remindersOwned", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, doneAt])
  @@index([dueOn])
  @@index([fleetId])
  @@map("reminders")
}

model SupportTicket {
  id        String         @id @default(cuid())

  /// A frota a que isto pertence. Ver `escopo.ts`: nenhuma consulta sai
  /// daqui sem esta coluna preenchida.
  fleetId String @default("") @map("fleet_id")
  subject   String
  category  TicketCategory
  message   String
  status    TicketStatus   @default(OPEN)
  userId    String         @map("user_id")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies TicketReply[]

  @@index([userId])
  @@index([status])
  @@index([fleetId])
  @@map("support_tickets")
}

model TicketReply {
  id        String   @id @default(cuid())

  /// A frota a que isto pertence. Ver `escopo.ts`: nenhuma consulta sai
  /// daqui sem esta coluna preenchida.
  fleetId String @default("") @map("fleet_id")
  message   String
  ticketId  String   @map("ticket_id")
  authorId  String   @map("author_id")
  createdAt DateTime @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([fleetId])
  @@map("ticket_replies")
}

/// Sociedades do grupo a quem os motoristas emitem recibo verde.
///
/// TABELA e não enum: o cliente opera várias sociedades e a lista muda —
/// criam-se, mudam de nome, dissolvem-se. Um enum obrigaria a uma migração de
/// cada vez, e a terceira sociedade dele nem nome tem ainda.
///
/// Renomear uma sociedade NÃO reescreve o histórico: as retiradas apontam para
/// o id, portanto continuam ligadas à mesma entidade jurídica.
model Company {
  id     String  @id @default(uuid())

  /// A frota a que isto pertence. Ver `escopo.ts`: nenhuma consulta sai
  /// daqui sem esta coluna preenchida.
  fleetId String @default("") @map("fleet_id")
  name   String
  /// Inativa desaparece das escolhas novas mas continua a explicar o passado.
  /// Apagar arrancaria a sociedade dos recibos já emitidos.
  active Boolean @default(true)
  /// Ordem de apresentação — o cliente listou-as numeradas.
  sortOrder Int @default(0) @map("sort_order")

  withdrawals Withdrawal[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([fleetId])

  @@map("companies")
}

model SystemSettings {
  /// Era uma linha só, com o id fixo "global". Com várias frotas passa a
  /// haver uma linha por frota: a comissão, o imposto e os limites são de
  /// cada uma. O `@@unique([fleetId])` é o que garante que continua a ser
  /// uma só — por frota.
  id                        String   @id @default(cuid())

  /// A frota a que isto pertence. Ver `escopo.ts`: nenhuma consulta sai
  /// daqui sem esta coluna preenchida.
  fleetId String @default("") @map("fleet_id")
  companyCommission         Int      @default(15) // %
  /// Imposto do Estado sobre a faturação TVDE, em pontos percentuais.
  /// Configurável e não cravado no código: o Estado altera taxas, e no dia em
  /// que isso acontecer os fechos passados têm de continuar a mostrar a que
  /// foi aplicada — por isso cada fecho grava a sua própria cópia.
  settlementTaxRate         Decimal  @default(6) @map("settlement_tax_rate") @db.Decimal(5, 2)
  minWithdrawalAmount       Int      @default(50) // €
  maxWithdrawalAmount       Int      @default(5000) // €
  withdrawalProcessingDays  Int      @default(1)
  documentExpiryWarningDays Int      @default(30)
  uberIntegration           Boolean  @default(true)
  boltIntegration           Boolean  @default(true)
  emailNotifications        Boolean  @default(true)
  smsNotifications          Boolean  @default(false)
  autoApproveDocuments      Boolean  @default(false)
  requireTwoFactorAuth      Boolean  @default(false)
  updatedAt                 DateTime @updatedAt
  updatedBy                 String?  @map("updated_by")

  @@index([fleetId])

  @@map("system_settings")
}

// ─────────────────────────────────────────────────────────────────────────────
// Fecho semanal de faturação
//
// A ÚNICA porta pela qual entra dinheiro na conta do motorista.
//
// O administrador regista, por semana e por motorista, o que entrou em cada
// plataforma e o que saiu em despesas; a percentagem da empresa incide sobre o
// lucro (receitas menos despesas), não sobre o bruto; e o líquido é creditado.
//
// Sem esta entidade, a comissão da empresa nunca era efetivamente cobrada: o
// saldo do motorista era 100% do que ele lançava, e a percentagem existia
// apenas como número nas telas de análise.
// ─────────────────────────────────────────────────────────────────────────────

enum SettlementStatus {
  DRAFT      // preparado, ainda nao creditado
  REGISTERED // creditado ao motorista — imutavel a partir daqui
  CANCELLED  // estornado; o credito e revertido
}

model WeeklySettlement {
  id        String  @id @default(cuid())

  /// A frota a que isto pertence. Ver `escopo.ts`: nenhuma consulta sai
  /// daqui sem esta coluna preenchida.
  fleetId String @default("") @map("fleet_id")
  userId    String  @map("user_id")
  vehicleId String? @map("vehicle_id")

  weekStart DateTime @map("week_start") @db.Date
  weekEnd   DateTime @map("week_end")   @db.Date

  // Receitas por plataforma. Campos nomeados em vez de uma tabela filha:
  // sao poucas plataformas, fixas, e assim o fecho e uma linha so.
  uberAmount   Decimal @default(0) @map("uber_amount")   @db.Decimal(12, 2)
  boltAmount   Decimal @default(0) @map("bolt_amount")   @db.Decimal(12, 2)
  otherRevenue Decimal @default(0) @map("other_revenue") @db.Decimal(12, 2)

  // Deducoes operacionais.
  tollsAmount     Decimal @default(0) @map("tolls_amount")     @db.Decimal(12, 2) // Via Verde
  fuelAmount      Decimal @default(0) @map("fuel_amount")      @db.Decimal(12, 2) // Prio
  /// Carregamento elétrico. Coluna PRÓPRIA e não partilhada com o
  /// combustível: um híbrido tem os dois na mesma semana, e depois de
  /// somados na mesma célula não há consulta que os separe.
  chargeAmount    Decimal @default(0) @map("charge_amount")    @db.Decimal(12, 2)
  vehicleFee      Decimal @default(0) @map("vehicle_fee")      @db.Decimal(12, 2)
  otherDeductions Decimal @default(0) @map("other_deductions") @db.Decimal(12, 2)

  // ── Imposto sobre a faturação ──────────────────────────────────────────────
  //
  // Pedido do cliente: "esse campo eu preciso que ele cobre 6% do valor bruto
  // da Uber e Bolt". A base é uber + bolt e NÃO inclui otherRevenue — foi o que
  // ele escreveu, e usar o grossRevenue tributaria receita que ele não mandou
  // tributar.
  //
  // TRÊS campos e não um. Guardar só o resultado deixaria impossível saber,
  // daqui a um ano, sobre que valor a taxa incidiu. Está por confirmar com o
  // contabilista dele se os campos Uber e Bolt guardam o bruto pago pelo
  // passageiro ou o líquido que a plataforma transfere — o IVA de 6% é devido
  // sobre o primeiro. Se a resposta mudar a interpretação, muda o cálculo da
  // base e o histórico fica intacto.
  //
  // NULO nos fechos anteriores a este campo, e não zero: as telas têm de poder
  // distinguir "não teve imposto" de "é anterior à existência do imposto".
  taxBase   Decimal? @map("tax_base")   @db.Decimal(12, 2)
  taxRate   Decimal? @map("tax_rate")   @db.Decimal(5, 2)
  taxAmount Decimal? @map("tax_amount") @db.Decimal(12, 2)

  // Percentagem aplicada, em pontos percentuais (15 = 15%).
  //
  // GRAVADA no fecho, e nao lida das configuracoes na hora de exibir: quando
  // alguem alterar a percentagem global, os fechos passados tem de continuar a
  // mostrar a conta que foi efetivamente paga. Recibo nao muda depois de
  // emitido.
  commissionRate Decimal @default(0) @map("commission_rate") @db.Decimal(5, 2)

  // Totais congelados no momento do registo. Guardados em vez de recalculados
  // na leitura, pela mesma razao: o documento tem de permanecer igual ao que
  // foi acordado, mesmo que a formula mude no futuro.
  grossRevenue     Decimal @default(0) @map("gross_revenue")     @db.Decimal(12, 2)
  totalDeductions  Decimal @default(0) @map("total_deductions")  @db.Decimal(12, 2)
  profitBase       Decimal @default(0) @map("profit_base")       @db.Decimal(12, 2)
  commissionAmount Decimal @default(0) @map("commission_amount") @db.Decimal(12, 2)
  netToDriver      Decimal @default(0) @map("net_to_driver")     @db.Decimal(12, 2)

  status SettlementStatus @default(DRAFT)

  /// Conta-quilómetros no início e no fim da semana. OPCIONAIS, e nulos em
  /// tudo o que é anterior a este campo: é a diferença entre "não foram
  /// registados" e "andou zero quilómetros", e um zero a fingir estragava
  /// qualquer média. A base garante que o fim não é menor que o início.
  odometerStart Int? @map("odometer_start")
  odometerEnd   Int? @map("odometer_end")

  /// Observações visíveis ao motorista, no detalhe da semana.
  notes String?

  /// Observações internas. NUNCA saem numa resposta para o motorista — ver o
  /// filtro em settlements.repository.toPublic. Existem separadas de `notes`
  /// porque aquelas já são mostradas no painel dele, e reaproveitar o campo
  /// exporia o que se pretende reservado.
  internalNotes String? @map("internal_notes")

  createdById  String    @map("created_by_id")
  registeredAt DateTime? @map("registered_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt      @map("updated_at")

  /// Quando este fecho foi corrigido DEPOIS de já ter sido creditado.
  ///
  /// Nulo é a maioria e quer dizer "nunca foi mexido depois de registado" —
  /// não se confunde com `updatedAt`, que mexe por tudo e mais alguma coisa,
  /// incluindo pelo próprio ato de registar.
  ///
  /// Existe como COLUNA e não como consulta às revisões porque é por aqui que
  /// o filtro da lista pesquisa, e um filtro que tenha de visitar outra tabela
  /// para cada linha é o género de coisa que fica lenta sem ninguém reparar.
  editedAfterRegisterAt DateTime? @map("edited_after_register_at")

  user      User     @relation("settlementsReceived", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User     @relation("settlementsCreated", fields: [createdById], references: [id])
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  revisions SettlementRevision[]
  queries   SettlementQuery[]

  // Guarda estrutural contra creditar a mesma semana duas vezes. E a protecao
  // que nao depende de ninguem se lembrar de conferir.
  @@unique([userId, weekStart])
  @@index([userId])
  @@index([weekStart])
  @@index([status])
  @@index([editedAfterRegisterAt])
  @@index([fleetId])
  @@map("weekly_settlements")
}

/// Uma correção feita a um fecho, com o motivo e o que mudou.
///
/// ─── PORQUE É QUE ISTO EXISTE ───────────────────────────────────────────────
///
/// Um fecho registado é dinheiro já creditado. Até aqui era imutável, e a única
/// forma de corrigir um engano era cancelar e criar outro — o que deixa o
/// extrato do motorista com um estorno e um lançamento novo para explicar uma
/// vírgula trocada.
///
/// Passa a poder ser editado, mas nunca em silêncio: cada correção escreve uma
/// linha aqui, e é essa linha que torna a edição aceitável. Sem ela, um saldo
/// que muda sozinho é indistinguível de uma avaria — ou de má-fé.
///
/// ─── PORQUE É QUE OS VALORES FICAM AQUI E NÃO SÓ NO FECHO ───────────────────
///
/// `changes` guarda o antes e o depois de cada campo tocado. Podia-se pensar
/// que basta guardar o antes e ir ao fecho buscar o depois — e basta, para a
/// última revisão. Para a penúltima não: o "depois" dela é o "antes" da
/// seguinte, e reconstruir isso de trás para a frente é o tipo de conta que
/// está certa até alguém apagar uma linha.
model SettlementRevision {
  id           String @id @default(cuid())

  /// A frota a que isto pertence. Ver `escopo.ts`: nenhuma consulta sai
  /// daqui sem esta coluna preenchida.
  fleetId String @default("") @map("fleet_id")
  settlementId String @map("settlement_id")

  /// Quem fez a correção. Só ADMIN, garantido no serviço.
  ///
  /// Opcional porque a conta pode ser apagada e o rasto não deve desaparecer
  /// com ela: fica a revisão sem autor, que é muito melhor do que nenhuma.
  editedById String? @map("edited_by_id")

  /// Obrigatório, e é o coração disto. Vai inteiro para a notificação do
  /// motorista: é a frase que ele vai ler quando o dinheiro dele mudar.
  reason String

  /// O estado em que o fecho estava quando foi corrigido (DRAFT/REGISTERED).
  /// Guardado porque corrigir um rascunho e corrigir dinheiro já creditado são
  /// duas coisas com peso muito diferente, e daqui a um ano ninguém saberá
  /// dizer qual foi qual.
  statusAtEdit SettlementStatus @map("status_at_edit")

  /// `[{ campo, antes, depois }]`. JSON e não colunas: os campos do fecho são
  /// muitos e mudam com o tempo, e uma tabela com uma coluna por campo teria de
  /// ser migrada sempre que o fecho ganhasse outro.
  changes Json

  createdAt DateTime @default(now()) @map("created_at")

  settlement WeeklySettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  editedBy   User?            @relation("settlementRevisions", fields: [editedById], references: [id], onDelete: SetNull)

  @@index([settlementId])
  @@index([createdAt])
  @@index([fleetId])
  @@map("settlement_revisions")
}


/* =========================
   INVESTIMENTOS
   =========================

   O motorista aplica parte do saldo num plano e o valor rende todos os dias.

   ─── ONDE O DINHEIRO ESTÁ ───────────────────────────────────────────────────

   Aplicar TIRA do saldo principal (o `principal` da aplicação é subtraído na
   view `driver_balances`), e resgatar DEVOLVE (o `payout` é somado). Entre uma
   coisa e outra o dinheiro vive aqui, e os ganhos diários acumulam-se na
   própria aplicação — NÃO no saldo principal. Só entram no saldo principal no
   resgate, como parte do `payout`.

   ─── JUROS SIMPLES ──────────────────────────────────────────────────────────

   Decisão do cliente: cada dia rende sobre o valor aplicado, nunca sobre os
   ganhos já acumulados. Ganho de um dia = principal × taxa anual ÷ 100 ÷ 365.

   ─── PORQUE HÁ UMA LINHA POR DIA ────────────────────────────────────────────

   `investment_accruals` guarda cada dia com a taxa que se aplicou nesse dia.
   Nos planos flexíveis a taxa muda; recalcular o passado com a taxa de hoje
   mudaria ganhos que o motorista já viu. Com uma linha por dia, o passado fica
   escrito e o `@@unique([investmentId, day])` impede que o job, corrido duas
   vezes, pague o mesmo dia duas vezes.
*/

enum InvestmentPlanType {
  /// Taxa fixa, congelada no momento da aplicação, com prazo.
  FIXED
  /// Taxa definida pela administração e alterável; o histórico fica em
  /// `investment_plan_rates`.
  FLEXIBLE
}

enum InvestmentStatus {
  ACTIVE
  CLOSED
}

enum InvestmentCloseReason {
  /// Plano fixo que chegou ao fim do prazo. Sem penalização.
  MATURED
  /// Plano fixo resgatado antes do prazo. Aplica a penalização do plano.
  EARLY
  /// Plano flexível resgatado pelo titular.
  WITHDRAWN
}

model InvestmentPlan {
  id          String             @id @default(cuid())

  /// A frota a que isto pertence. Ver `escopo.ts`: nenhuma consulta sai
  /// daqui sem esta coluna preenchida.
  fleetId String @default("") @map("fleet_id")
  name        String
  description String?
  type        InvestmentPlanType

  /// Taxa anual em percentagem (2.5 = 2,5% ao ano).
  ///
  /// Nos FIXOS é a taxa oferecida a quem aplicar a partir de agora — quem já
  /// aplicou fica com a que estava em vigor (copiada para a aplicação).
  /// Nos FLEXÍVEIS é a taxa em vigor hoje; a que conta para cada dia vem do
  /// histórico em `investment_plan_rates`.
  annualRate  Decimal            @map("annual_rate") @db.Decimal(6, 3)

  /// Só FIXED: duração em dias.
  termDays    Int?               @map("term_days")

  /// Só FIXED: penalização por resgate antecipado, em % do valor aplicado.
  earlyWithdrawalPenalty Decimal? @map("early_withdrawal_penalty") @db.Decimal(5, 2)

  minAmount   Decimal            @default(0) @map("min_amount") @db.Decimal(12, 2)

  /// Rank mínimo para aplicar neste plano. Nulo = aberto a todos.
  minRank     RankTier?          @map("min_rank")

  /// Desativar deixa de aceitar aplicações novas; as que existem continuam.
  active      Boolean            @default(true)

  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  rates       InvestmentPlanRate[]
  investments Investment[]

  @@index([fleetId])

  @@map("investment_plans")
}

/// Histórico de taxas de um plano. Cada linha vale a partir de `effectiveFrom`
/// até à linha seguinte. Nunca se altera um dia que já foi pago: o serviço só
/// aceita `effectiveFrom` de hoje em diante.
model InvestmentPlanRate {
  id            String   @id @default(cuid())

  /// A frota a que isto pertence. Ver `escopo.ts`: nenhuma consulta sai
  /// daqui sem esta coluna preenchida.
  fleetId String @default("") @map("fleet_id")
  planId        String   @map("plan_id")
  annualRate    Decimal  @map("annual_rate") @db.Decimal(6, 3)
  effectiveFrom DateTime @map("effective_from") @db.Date
  createdBy     String?  @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  plan InvestmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, effectiveFrom])
  @@index([fleetId])
  @@map("investment_plan_rates")
}

model Investment {
  id        String   @id @default(cuid())

  /// A frota a que isto pertence. Ver `escopo.ts`: nenhuma consulta sai
  /// daqui sem esta coluna preenchida.
  fleetId String @default("") @map("fleet_id")
  userId    String   @map("user_id")
  planId    String   @map("plan_id")

  /// O valor aplicado. Sai do saldo principal no momento da aplicação.
  principal Decimal  @db.Decimal(12, 2)

  /// Copiados do plano no momento da aplicação, e congelados. Mudar o plano
  /// depois não muda o que foi prometido a quem já aplicou.
  /// `annualRate` só nos FIXOS; nos FLEXÍVEIS fica nulo e a taxa de cada dia
  /// vem do histórico do plano.
  planType    InvestmentPlanType @map("plan_type")
  annualRate  Decimal?           @map("annual_rate") @db.Decimal(6, 3)
  termDays    Int?               @map("term_days")
  penaltyRate Decimal?           @map("penalty_rate") @db.Decimal(5, 2)

  /// Dia (em Lisboa) em que foi aplicado. Rende a partir deste dia, inclusive.
  startDate    DateTime  @map("start_date") @db.Date
  /// Só FIXED: startDate + termDays. Rende até à véspera; neste dia fecha.
  maturityDate DateTime? @map("maturity_date") @db.Date

  /// Último dia já pago em `investment_accruals`. Nulo = nenhum.
  accruedThrough DateTime? @map("accrued_through") @db.Date
  /// Soma das linhas diárias, com seis casas: arredondar cada dia ao cêntimo
  /// perderia até meio cêntimo por dia, e num ano isso nota-se.
  accrued        Decimal   @default(0) @db.Decimal(16, 6)

  status      InvestmentStatus       @default(ACTIVE)
  closeReason InvestmentCloseReason? @map("close_reason")

  /// O que voltou ao saldo principal: principal + ganhos − penalização,
  /// arredondado ao cêntimo. É este valor que a view soma.
  payout        Decimal?  @db.Decimal(12, 2)
  penaltyAmount Decimal?  @map("penalty_amount") @db.Decimal(12, 2)

  createdAt DateTime  @default(now()) @map("created_at")
  closedAt  DateTime? @map("closed_at")

  /// Cascade como os fechos e os ajustes: apagar um utilizador leva o histórico
  /// dele. O serviço de utilizadores RECUSA apagar quem tem aplicações ativas —
  /// isso seria apagar dinheiro que a empresa deve.
  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan     InvestmentPlan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  accruals InvestmentAccrual[]

  @@index([userId])
  @@index([status])
  @@index([planId])
  @@index([fleetId])
  @@map("investments")
}

model InvestmentAccrual {
  id           String   @id @default(cuid())

  /// A frota a que isto pertence. Ver `escopo.ts`: nenhuma consulta sai
  /// daqui sem esta coluna preenchida.
  fleetId String @default("") @map("fleet_id")
  investmentId String   @map("investment_id")
  day          DateTime @db.Date
  /// A taxa que se aplicou neste dia. Guardada para o extrato explicar o valor.
  annualRate   Decimal  @map("annual_rate") @db.Decimal(6, 3)
  amount       Decimal  @db.Decimal(16, 6)
  createdAt    DateTime @default(now()) @map("created_at")

  investment Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)

  @@unique([investmentId, day])
  @@index([fleetId])
  @@map("investment_accruals")
}


/* =========================
   RANKS
   =========================

   Cinco níveis, do mais baixo para o mais alto. Os nomes e as cores são
   editáveis no painel — nascem como Dragon Driver, Dragon Elite, Dragon Leader,
   Dragon Manager e Dragon Master — e o código usa sempre TIER_1..TIER_5, para
   mudar um nome não obrigar a uma migração.

   ─── COMO SE SOBE E SE DESCE ────────────────────────────────────────────────

   As metas contam dentro de uma TEMPORADA de dois meses do calendário
   (janeiro–fevereiro, março–abril, …). Durante a temporada o rank acompanha as
   metas em tempo real: atinge, sobe e ganha os benefícios nesse momento; deixa
   de cumprir, desce e perde-os.

   ─── A PROTEÇÃO DE 30 DIAS ──────────────────────────────────────────────────

   No fim da temporada, o rank com que terminou fica GARANTIDO COMO MÍNIMO
   durante 30 dias. Em março ninguém fica abaixo do que conquistou até 28 de
   fevereiro, mesmo começando a nova temporada do zero. Para cima não há
   travão: se as metas novas derem um rank melhor, esse vale de imediato.

   Guarda-se `floorTier` e `floorUntil`, e o rank efetivo é o maior dos dois.
*/

enum RankTier {
  TIER_1
  TIER_2
  TIER_3
  TIER_4
  TIER_5
}

enum RankEventKind {
  /// Subiu de rank dentro da temporada.
  UP
  /// Desceu de rank dentro da temporada.
  DOWN
  /// Fim de temporada: o rank alcançado passou a mínimo garantido.
  SEASON_END
  /// Acabaram os 30 dias de proteção.
  FLOOR_EXPIRED
}

/// As metas e os benefícios de cada nível. Uma linha por nível, sempre cinco.
model RankConfig {
  /// A frota a que isto pertence. Ver `escopo.ts`.
  fleetId String @default("") @map("fleet_id")
  /// A chave passou a ser a frota MAIS o nível: cada frota tem os seus
  /// cinco níveis, com as metas e as vantagens dela.
  tier  RankTier
  label String
  /// Cor base em hexadecimal, usada no cartão e no emblema.
  color String

  // ── Metas. Zero = não conta. ──
  /// Faturação (bruto dos fechos) acumulada DENTRO da temporada.
  minSeasonRevenue Decimal @default(0) @map("min_season_revenue") @db.Decimal(12, 2)
  /// Valor aplicado em investimentos, neste momento.
  minInvested      Decimal @default(0) @map("min_invested") @db.Decimal(12, 2)
  /// Saldo disponível em banca, neste momento.
  minBalance       Decimal @default(0) @map("min_balance") @db.Decimal(12, 2)
  /// Semanas com fecho registado dentro da temporada.
  minWeeks         Int     @default(0) @map("min_weeks")

  /// Documentos expirados travam a subida a este nível.
  requireValidDocuments Boolean @default(true) @map("require_valid_documents")

  // ── Benefícios. Em percentagem; a aplicação ao fecho semanal fica para a
  //    fase 2, mas os valores vivem aqui desde já para o motorista os ver. ──
  fuelDiscount        Decimal @default(0) @map("fuel_discount") @db.Decimal(5, 2)
  vehicleDiscount     Decimal @default(0) @map("vehicle_discount") @db.Decimal(5, 2)
  tollsDiscount       Decimal @default(0) @map("tolls_discount") @db.Decimal(5, 2)
  /// Pontos percentuais somados à taxa dos investimentos (fase 2).
  investmentRateBonus Decimal @default(0) @map("investment_rate_bonus") @db.Decimal(5, 3)
  /// Texto livre, uma vantagem por linha, mostrado ao motorista.
  perks               String?

  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([fleetId, tier])
  @@index([fleetId])
  @@map("rank_configs")
}

/// O estado de cada motorista. Uma linha por utilizador, criada no primeiro
/// cálculo.
model DriverRank {
  userId String @id @map("user_id")

  /// A frota a que isto pertence. Ver `escopo.ts`: nenhuma consulta sai
  /// daqui sem esta coluna preenchida.
  fleetId String @default("") @map("fleet_id")

  /// O que vale hoje: o maior entre o conquistado e o garantido.
  tier       RankTier @default(TIER_1)
  /// O que as metas dão neste momento.
  earnedTier RankTier @default(TIER_1) @map("earned_tier")

  /// Mínimo garantido e até quando. Nulos fora do período de proteção.
  floorTier  RankTier? @map("floor_tier")
  floorUntil DateTime? @map("floor_until") @db.Date

  /// Primeiro dia da temporada a que as métricas abaixo dizem respeito.
  seasonStart DateTime @map("season_start") @db.Date

  // Métricas do último cálculo, guardadas para a tela não as recalcular.
  seasonRevenue Decimal @default(0) @map("season_revenue") @db.Decimal(12, 2)
  invested      Decimal @default(0) @db.Decimal(12, 2)
  balance       Decimal @default(0) @db.Decimal(12, 2)
  weeks         Int     @default(0)
  /// Falso quando há documentos expirados: trava a subida.
  documentsOk   Boolean @default(true) @map("documents_ok")

  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tier])
  @@index([fleetId])
  @@map("driver_ranks")
}

/// Histórico: quando subiu, quando desceu, e porquê. Sem isto, um motorista que
/// pergunte "porque perdi o desconto" não tem resposta.
model RankEvent {
  id         String        @id @default(cuid())

  /// A frota a que isto pertence. Ver `escopo.ts`: nenhuma consulta sai
  /// daqui sem esta coluna preenchida.
  fleetId String @default("") @map("fleet_id")
  userId     String        @map("user_id")
  kind       RankEventKind
  tier       RankTier
  fromTier   RankTier?     @map("from_tier")
  /// Explicação curta, já escrita para ser mostrada.
  note       String?
  createdAt  DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([fleetId])
  @@map("rank_events")
}

/* =========================
   PORTAL DO INVESTIDOR
   invest.dragonfleet.pt
   ========================= */

/// Estado da conta. FECHADA não aceita depósitos nem rende; o histórico fica.
enum InvestorAccountStatus {
  ACTIVE
  CLOSED
}

/// Os dois bolsos de uma conta de investidor.
///
/// CAPITAL é o que foi depositado; EARNINGS é o que os juros somaram. Andam
/// separados porque o rendimento pode ser levantado sem mexer no capital, e
/// porque os juros de cada dia contam sobre o capital e não sobre o total.
enum InvestorBucket {
  CAPITAL
  EARNINGS
}

enum InvestorMovementKind {
  DEPOSIT
  ACCRUAL
  WITHDRAWAL
  ADJUSTMENT
  /// Distribuição mensal do lucro de um projeto.
  PROFIT_SHARE
  /// Mais-valia (ou perda) apurada quando um projeto liquida.
  PROJECT_RESULT
}

enum InvestorWithdrawalStatus {
  PENDING
  PAID
  REJECTED
}

/// A conta de um investidor. Uma por utilizador com o papel INVESTOR.
model InvestorAccount {
  id     String @id @default(cuid())

  /// A frota a que isto pertence. Ver `escopo.ts`: nenhuma consulta sai
  /// daqui sem esta coluna preenchida.
  fleetId String @default("") @map("fleet_id")
  userId String @unique @map("user_id")

  /// Primeiro dia que pode render.
  startDate      DateTime  @map("start_date") @db.Date
  /// Último dia já pago em movimentos ACCRUAL. Nulo = ainda não rendeu.
  accruedThrough DateTime? @map("accrued_through") @db.Date

  /// Dias de aviso prévio para levantar capital. Zero = sem aviso.
  /// Não se aplica ao rendimento.
  noticeDays Int @default(0) @map("notice_days")

  status InvestorAccountStatus @default(ACTIVE)
  notes  String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// RESTRICT: apagar um utilizador não pode levar o registo do dinheiro que
  /// ele pôs cá dentro. Fecha-se a posição primeiro.
  user        User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  rates       InvestorRate[]
  movements   InvestorMovement[]
  withdrawals InvestorWithdrawal[]
  shares      ProjectShare[]

  @@index([fleetId])

  @@map("investor_accounts")
}

/// A taxa não é uma coluna da conta: é uma série com datas.
///
/// Assim, baixar a taxa hoje não reescreve os juros já pagos — cada dia é pago
/// à taxa que estava em vigor nesse dia.
model InvestorRate {
  id            String   @id @default(cuid())

  /// A frota a que isto pertence. Ver `escopo.ts`: nenhuma consulta sai
  /// daqui sem esta coluna preenchida.
  fleetId String @default("") @map("fleet_id")
  accountId     String   @map("account_id")
  effectiveFrom DateTime @map("effective_from") @db.Date
  annualRate    Decimal  @map("annual_rate") @db.Decimal(6, 3)
  createdAt     DateTime @default(now()) @map("created_at")
  createdBy     String?  @map("created_by")

  account InvestorAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, effectiveFrom], map: "investor_rates_account_from_key")
  @@index([fleetId])
  @@map("investor_rates")
}

/// O extrato. O saldo é a soma disto — não há coluna de saldo em lado nenhum.
model InvestorMovement {
  id        String @id @default(cuid())

  /// A frota a que isto pertence. Ver `escopo.ts`: nenhuma consulta sai
  /// daqui sem esta coluna preenchida.
  fleetId String @default("") @map("fleet_id")
  accountId String @map("account_id")

  /// Dia civil em Lisboa a que o movimento pertence. O juro do dia 30 é
  /// lançado na madrugada do 31 e tem de aparecer no dia 30.
  day DateTime @db.Date

  kind   InvestorMovementKind
  bucket InvestorBucket

  /// Com sinal: entradas positivas, saídas negativas. Somar dá o saldo.
  amount Decimal @db.Decimal(16, 6)

  description  String?
  withdrawalId String? @map("withdrawal_id")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  /// O projeto que gerou este movimento, quando veio de um.
  /// Sem isto, o extrato mostrava "+142,30 €" sem dizer de que carro veio.
  projectId String? @map("project_id")

  account InvestorAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  project InvestmentProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([accountId, day])
  @@index([projectId])
  @@index([fleetId])
  @@map("investor_movements")
}

/// Pedido de resgate. Só vira movimento quando a administração o marca como
/// pago — antes disso é dinheiro prometido, descontado do disponível.
model InvestorWithdrawal {
  id        String         @id @default(cuid())

  /// A frota a que isto pertence. Ver `escopo.ts`: nenhuma consulta sai
  /// daqui sem esta coluna preenchida.
  fleetId String @default("") @map("fleet_id")
  accountId String         @map("account_id")
  bucket    InvestorBucket
  amount    Decimal        @db.Decimal(12, 2)

  status InvestorWithdrawalStatus @default(PENDING)

  /// Já com o aviso prévio contado.
  availableOn DateTime @map("available_on") @db.Date

  note     String?
  decision String?

  createdAt DateTime  @default(now()) @map("created_at")
  decidedAt DateTime? @map("decided_at")
  decidedBy String?   @map("decided_by")

  account InvestorAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([status])
  @@index([fleetId])
  @@map("investor_withdrawals")
}


/* =========================
   PROJETOS DE INVESTIMENTO
   participação nos lucros de um carro
   ========================= */

/// O ciclo de vida de um projeto.
enum ProjectStatus {
  /// A preparar. Os investidores não o veem.
  DRAFT
  /// Aberto a subscrições.
  FUNDING
  /// Financiado; o carro a render e a distribuir todos os meses.
  ACTIVE
  /// Liquidado: o capital voltou às contas dos investidores.
  CLOSED
  /// Abortado antes de arrancar; o capital foi libertado.
  CANCELLED
}

enum ProjectShareStatus {
  ACTIVE
  LIQUIDATED
  CANCELLED
}

enum ProjectPeriodStatus {
  /// Apurado, ainda não pago.
  DRAFT
  /// Pago aos investidores.
  DISTRIBUTED
}

/// Um projeto: um carro financiado por investidores, que repartem o que ele der.
///
/// AS DISTRIBUIÇÕES MENSAIS NÃO AMORTIZAM O CAPITAL. Quem pôs 10 000 €
/// continua com 10 000 € em dívida depois de já ter recebido 10 000 € de
/// lucros; o capital só volta na liquidação. Foi uma decisão explícita do
/// cliente e é o que faz o investidor continuar a ganhar enquanto o carro
/// rodar. Está escrito aqui porque quem ler isto daqui a dois anos vai assumir
/// o contrário.
model InvestmentProject {
  id          String  @id @default(cuid())

  /// A frota a que isto pertence. Ver `escopo.ts`: nenhuma consulta sai
  /// daqui sem esta coluna preenchida.
  fleetId String @default("") @map("fleet_id")
  name        String
  description String?

  /// Quanto é preciso angariar.
  targetAmount Decimal @map("target_amount") @db.Decimal(12, 2)
  /// Mínimo por participação. Zero = sem mínimo.
  minTicket    Decimal @default(0) @map("min_ticket") @db.Decimal(12, 2)

  /// A fatia do lucro que vai para os investidores, em percentagem.
  profitShare  Decimal @default(50) @map("profit_share") @db.Decimal(5, 2)

  /// O carro. Nulo enquanto não estiver escolhido.
  vehicleId String? @map("vehicle_id")

  /// Que parcelas do fecho semanal contam como rendimento do carro.
  includeCommission Boolean @default(true) @map("include_commission")
  includeVehicleFee Boolean @default(true) @map("include_vehicle_fee")

  status ProjectStatus @default(DRAFT)

  fundingClosesOn DateTime? @map("funding_closes_on") @db.Date
  /// Primeiro mês que conta lucro.
  startedOn       DateTime? @map("started_on") @db.Date
  /// Prazo OPCIONAL. Vazio = corre até o carro ser vendido.
  endsOn          DateTime? @map("ends_on") @db.Date
  closedOn        DateTime? @map("closed_on") @db.Date

  /// Quanto rendeu a venda. É isto que se reparte na liquidação.
  saleAmount Decimal? @map("sale_amount") @db.Decimal(12, 2)

  riskLevel String? @map("risk_level")
  imageUrl  String? @map("image_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  vehicle   Vehicle?           @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  shares    ProjectShare[]
  periods   ProjectPeriod[]
  expenses  ProjectExpense[]
  updates   ProjectUpdate[]
  movements InvestorMovement[]

  @@index([status])
  @@index([vehicleId])
  @@index([fleetId])
  @@map("investment_projects")
}

/// A participação de um investidor num projeto.
///
/// Enquanto está ACTIVE, o valor sai do DISPONÍVEL da conta dele mas continua
/// a contar como capital — a empresa continua a devê-lo. É a view
/// `investor_balances` que faz essa distinção.
model ProjectShare {
  id        String @id @default(cuid())

  /// A frota a que isto pertence. Ver `escopo.ts`: nenhuma consulta sai
  /// daqui sem esta coluna preenchida.
  fleetId String @default("") @map("fleet_id")
  projectId String @map("project_id")
  accountId String @map("account_id")

  amount Decimal @db.Decimal(12, 2)

  status ProjectShareStatus @default(ACTIVE)

  /// O que voltou na liquidação. Pode ser menos do que entrou, se o carro se
  /// desvalorizou — é a contrapartida de ter recebido lucros sem que isso
  /// abatesse o capital.
  liquidatedAmount Decimal?  @map("liquidated_amount") @db.Decimal(12, 2)
  liquidatedAt     DateTime? @map("liquidated_at")

  createdAt DateTime @default(now()) @map("created_at")

  project InvestmentProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// RESTRICT: apagar uma conta de investidor não pode levar por à frente o
  /// registo do que ele pôs num carro.
  account InvestorAccount   @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@index([accountId])
  @@index([fleetId])
  @@map("project_shares")
}

/// Um mês de um projeto, com as parcelas à vista.
///
/// As parcelas ficam guardadas e não recalculadas na leitura: um investidor
/// que pergunte "de onde vem este valor" tem de ter resposta, e alterar a
/// percentagem do projeto não pode reescrever meses já pagos.
model ProjectPeriod {
  id        String   @id @default(cuid())

  /// A frota a que isto pertence. Ver `escopo.ts`: nenhuma consulta sai
  /// daqui sem esta coluna preenchida.
  fleetId String @default("") @map("fleet_id")
  projectId String   @map("project_id")
  /// Sempre o dia 1 do mês.
  month     DateTime @db.Date

  commissionTotal  Decimal @default(0) @map("commission_total") @db.Decimal(12, 2)
  vehicleFeeTotal  Decimal @default(0) @map("vehicle_fee_total") @db.Decimal(12, 2)
  expensesTotal    Decimal @default(0) @map("expenses_total") @db.Decimal(12, 2)
  settlementsCount Int     @default(0) @map("settlements_count")

  /// comissão + aluguer − despesas
  profit          Decimal @default(0) @db.Decimal(12, 2)
  /// A fatia dos investidores. Nunca negativa: um mês de prejuízo distribui
  /// zero, não cobra ao investidor.
  investorsAmount Decimal @default(0) @map("investors_amount") @db.Decimal(12, 2)
  /// A percentagem em vigor no apuramento, congelada.
  profitShare     Decimal @map("profit_share") @db.Decimal(5, 2)

  status        ProjectPeriodStatus @default(DRAFT)
  distributedAt DateTime?           @map("distributed_at")
  notes         String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project InvestmentProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, month], map: "project_periods_project_month_key")
  @@index([fleetId])
  @@map("project_periods")
}

/// Despesas do carro que não passam pelo fecho semanal: seguro, revisão,
/// pneus, IUC. Sem um sítio para as lançar, o lucro apurado seria sempre
/// otimista.
model ProjectExpense {
  id          String   @id @default(cuid())

  /// A frota a que isto pertence. Ver `escopo.ts`: nenhuma consulta sai
  /// daqui sem esta coluna preenchida.
  fleetId String @default("") @map("fleet_id")
  projectId   String   @map("project_id")
  month       DateTime @db.Date
  amount      Decimal  @db.Decimal(12, 2)
  description String
  createdAt   DateTime @default(now()) @map("created_at")
  createdBy   String?  @map("created_by")

  project InvestmentProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, month])
  @@index([fleetId])
  @@map("project_expenses")
}


/// As etapas de um projeto, do financiamento ao carro a render.
///
/// Lista fechada porque é o que permite desenhar uma escada de progresso e
/// dizer "vamos em 4 de 7". O texto de cada entrada é livre — cada carro tem a
/// sua história, e obrigá-la a caber num enum daria entradas sem conteúdo.
enum ProjectUpdateStage {
  FUNDING_COMPLETE
  FUNDS_RECEIVED
  VEHICLE_PAID
  PAPERWORK
  INSURANCE
  TVDE_LICENSE
  DRIVER_ASSIGNED
  EARNING
  MAINTENANCE
  INCIDENT
  SALE
  OTHER
}

/// Uma entrada do diário de bordo de um projeto.
///
/// Entre o financiamento fechar e o carro render passam semanas, e durante
/// esse tempo o investidor tem dinheiro parado num projeto que não distribui
/// nada. É esta sequência que lhe diz onde as coisas estão — e que substitui o
/// telefonema.
model ProjectUpdate {
  id        String @id @default(cuid())

  /// A frota a que isto pertence. Ver `escopo.ts`: nenhuma consulta sai
  /// daqui sem esta coluna preenchida.
  fleetId String @default("") @map("fleet_id")
  projectId String @map("project_id")

  stage ProjectUpdateStage @default(OTHER)
  title String
  body  String?

  /// Fotografia do carro, do documento, do que for. Uma imagem de um carro
  /// real vale mais do que três parágrafos a dizer que ele existe.
  imageUrl String? @map("image_url")

  /// O dia a que a entrada se refere, que não é o dia em que foi escrita: o
  /// pagamento foi feito na sexta e registado na segunda.
  happenedOn DateTime @map("happened_on") @db.Date

  /// Falso deixa a entrada só para uso interno.
  visible Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  project InvestmentProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, happenedOn])
  @@index([fleetId])
  @@map("project_updates")
}


/* =========================
   PERMISSÕES DA EQUIPA
   ========================= */

/// As áreas do painel de administração. Uma por entrada do menu.
enum StaffArea {
  DASHBOARD
  DRIVERS
  DOCUMENTS
  FLEET
  RANKS
  SETTLEMENTS
  FINANCIAL
  GREEN_RECEIPTS
  ANALYTICS
  INVESTMENTS
  INVESTORS
  PROJECTS
  NOTIFICATIONS
  SUPPORT
  SETTINGS
  TEAM
}

/// NONE não vê; VIEW lê; MANAGE lê e escreve.
///
/// NONE é um valor explícito e não a ausência de linha: "nunca foi
/// configurado" e "foi expressamente tirado" são coisas diferentes, e só a
/// primeira cai no comportamento antigo do papel.
enum StaffAccess {
  NONE
  VIEW
  MANAGE
}

/// O que uma pessoa da equipa pode fazer em cada área.
///
/// DUAS REGRAS QUE NÃO SE MEXEM:
///   1. O ADMIN tem tudo, sempre, e estas linhas são ignoradas para ele —
///      senão uma configuração errada tranca o dono fora do sistema.
///   2. Sem linhas nenhumas, vale o comportamento antigo do papel.
model StaffPermission {
  id     String      @id @default(cuid())

  /// A frota a que isto pertence. Ver `escopo.ts`: nenhuma consulta sai
  /// daqui sem esta coluna preenchida.
  fleetId String @default("") @map("fleet_id")
  userId String      @map("user_id")
  area   StaffArea
  access StaffAccess @default(NONE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, area], map: "staff_permissions_user_area_key")
  @@index([fleetId])
  @@map("staff_permissions")
}

/// Uma oficina, um centro de inspeção, um sítio de pneus.
///
/// Tudo o mesmo modelo porque, do ponto de vista de uma marcação, são a mesma
/// coisa: um sítio com morada e telefone, para onde se leva um carro a uma
/// hora combinada. O `kind` serve para o ecrã agrupar e para o formulário
/// sugerir — não muda regra nenhuma.
model Workshop {
  id      String  @id @default(cuid())

  /// A frota a que isto pertence. Ver `escopo.ts`: nenhuma consulta sai
  /// daqui sem esta coluna preenchida.
  fleetId String @default("") @map("fleet_id")
  name    String
  kind    String  @default("OFICINA")   // OFICINA | INSPECAO | PNEUS | OUTRO
  address String?
  phone   String?
  notes   String?

  /// Desligada em vez de apagada: as marcações antigas continuam a apontar
  /// para ela, e apagá-la deixaria o histórico a falar de uma oficina que já
  /// não existe.
  active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  staff    User[]    @relation("workshopStaff")
  bookings Booking[]

  @@index([active])
  @@index([fleetId])
  @@map("workshops")
}

/// Um tipo de serviço: troca de óleo, pneus, inspeção periódica, furo.
///
/// Tabela e não `enum` pela mesma razão dos tipos de pagamento: quem usa isto
/// tem de poder acrescentar os seus sem esperar por um deploy.
model ServiceType {
  id    String  @id @default(cuid())

  /// A frota a que isto pertence. Ver `escopo.ts`: nenhuma consulta sai
  /// daqui sem esta coluna preenchida.
  fleetId String @default("") @map("fleet_id")
  label String

  /// Marca os que são inspeção periódica, para o sistema poder actualizar a
  /// data da próxima inspeção do carro quando uma destas for concluída. É a
  /// única razão por que o sistema precisa de distinguir um tipo dos outros.
  isInspection Boolean @default(false) @map("is_inspection")

  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  bookings Booking[]

  @@unique([fleetId, label])
  @@index([fleetId])

  @@map("service_types")
}

/// Uma ida do carro à oficina: o que é, onde, quando, e com quem.
///
/// ─── PORQUE É QUE O MOTORISTA FICA GRAVADO ─────────────────────────────────
///
/// `driverId` é escrito quando a marcação nasce, a partir de quem tem o carro
/// nessa altura — e não lido da atribuição na hora de mostrar. Se o carro
/// mudar de mãos entretanto, a marcação continua a dizer quem a tinha de
/// cumprir, que é a pergunta que se faz quando alguém não apareceu.
///
/// ─── E PORQUE É QUE O CUSTO É NULO ATÉ AO FIM ──────────────────────────────
///
/// Nulo não é zero. Zero quer dizer "não custou nada", e há reparações em
/// garantia que não custam mesmo. Nulo quer dizer "ainda não se sabe", que é o
/// estado de tudo o que ainda não foi feito.
model Booking {
  id        String @id @default(cuid())

  /// A frota a que isto pertence. Ver `escopo.ts`: nenhuma consulta sai
  /// daqui sem esta coluna preenchida.
  fleetId String @default("") @map("fleet_id")
  vehicleId String @map("vehicle_id")

  /// Quem tinha o carro quando isto foi marcado. Nulo se o carro não estava
  /// com ninguém.
  driverId String? @map("driver_id")

  workshopId    String @map("workshop_id")
  serviceTypeId String @map("service_type_id")

  /// O que é preciso fazer, por palavras. É isto que a oficina lê.
  description String?

  /// O dia e a hora combinados. Quem pede propõe; a oficina confirma ou
  /// contrapõe em `proposedAt`.
  scheduledAt DateTime @map("scheduled_at")

  /// A hora que a oficina propôs em alternativa, e porquê. Nulos fora desse
  /// estado.
  proposedAt     DateTime? @map("proposed_at")
  proposalReason String?   @map("proposal_reason")

  status    BookingStatus    @default(PENDENTE)
  logistics BookingLogistics @default(MOTORISTA_LEVA)

  /// O motorista pediu que fosse alguém da empresa com ele.
  ///
  /// Existe por uma razão concreta: há carros em nome da empresa que são dos
  /// motoristas, e certas coisas exigem lá um responsável da empresa por eles
  /// não serem os donos no papel.
  needsEscort Boolean @default(false) @map("needs_escort")
  escortId    String? @map("escort_id")

  /// O que custou, escrito ao concluir. Nulo até lá — ver a nota acima.
  cost Decimal? @db.Decimal(12, 2)

  /// Notas de quem concluiu: o que foi feito, o que ficou por fazer.
  completionNotes String?   @map("completion_notes")
  completedAt     DateTime? @map("completed_at")

  /// Quem cancelou ou recusou, e porquê. Uma recusa sem motivo obriga a um
  /// telefonema, que é precisamente o que isto existe para evitar.
  cancelReason String? @map("cancel_reason")

  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt      @map("updated_at")

  vehicle     Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver      User?       @relation("bookingsForDriver", fields: [driverId], references: [id], onDelete: SetNull)
  escort      User?       @relation("bookingsEscorted", fields: [escortId], references: [id], onDelete: SetNull)
  workshop    Workshop    @relation(fields: [workshopId], references: [id])
  serviceType ServiceType @relation(fields: [serviceTypeId], references: [id])
  createdBy   User        @relation("bookingsRequested", fields: [createdById], references: [id])
  files       BookingFile[]
  /// O material gasto nesta ida à oficina. É o que permite somar o custo real
  /// da reparação: a factura da oficina mais o que saiu do nosso stock.
  stockMoves  StockMove[] @relation("stockMovesForBooking")

  @@index([vehicleId])
  @@index([driverId])
  // A pergunta do portal da oficina: o que tenho por confirmar, e para quando.
  @@index([workshopId, status])
  @@index([scheduledAt])
  @@index([fleetId])
  @@map("bookings")
}

/// A factura da reparação, o comprovativo do pagamento.
///
/// Guardados como os outros ficheiros do projeto: o Cloudinary fica com o
/// ficheiro e aqui fica o endereço e a chave. A chave é o que permite apagá-lo
/// de lá um dia — sem ela, apagar o registo deixava o ficheiro a ocupar espaço
/// para sempre.
model BookingFile {
  id        String          @id @default(cuid())

  /// A frota a que isto pertence. Ver `escopo.ts`: nenhuma consulta sai
  /// daqui sem esta coluna preenchida.
  fleetId String @default("") @map("fleet_id")
  bookingId String          @map("booking_id")
  kind      BookingFileKind
  fileUrl   String          @map("file_url")
  fileKey   String          @map("file_key")
  /// O nome que o ficheiro tinha, para a lista não mostrar só endereços.
  fileName  String?         @map("file_name")

  uploadedById String   @map("uploaded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  booking    Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation("bookingFilesUploaded", fields: [uploadedById], references: [id])

  @@index([bookingId])
  @@index([fleetId])
  @@map("booking_files")
}

/* =========================
   INVENTÁRIO DE MATERIAL
   ========================= */

/// Em que sentido o stock se mexeu.
///
/// ─── PORQUE É QUE O AJUSTE É UM TIPO À PARTE ────────────────────────────────
///
/// Porque não é compra nem consumo: é a contagem a dizer que a conta estava
/// errada. Registado como entrada, inflacionava o que se gastou em compras;
/// registado como saída, aparecia como material consumido num carro que nunca
/// o viu. Com um tipo próprio, os relatórios de custo podem ignorá-lo — e a
/// diferença continua escrita, com data e com autor, que é o que permite
/// descobrir para onde é que o material está a desaparecer.
enum StockMoveKind {
  ENTRADA
  SAIDA
  AJUSTE
}

/// Uma coisa que se tem em stock: óleo, filtros, pastilhas, um pneu.
///
/// ─── O SALDO É UMA COLUNA E TAMBÉM UM HISTÓRICO ─────────────────────────────
///
/// `qty` é o stock de agora e `StockMove` é como se chegou lá. Guardar as duas
/// coisas parece redundante até à primeira listagem: somar os movimentos de
/// trezentos materiais para desenhar uma tabela é uma consulta por linha, e a
/// tela passa a demorar segundos. O saldo é escrito na MESMA transação do
/// movimento, portanto não há como um existir sem o outro.
///
/// ─── E O CUSTO É MÉDIO PONDERADO ────────────────────────────────────────────
///
/// A pergunta a que isto serve é "quanto é que me custou o material que gastei
/// neste carro". Com o mesmo óleo comprado a 4,10 € e depois a 4,60 €, o preço
/// da última compra responde mal — e o da primeira responde pior. A média
/// ponderada pelas quantidades é a conta que a contabilidade portuguesa aceita
/// (custo médio ponderado) e a única que não depende da ordem em que se gasta.
model Material {
  id   String  @id @default(cuid())

  /// A frota a que isto pertence. Ver `escopo.ts`: nenhuma consulta sai
  /// daqui sem esta coluna preenchida.
  fleetId String @default("") @map("fleet_id")
  name String
  /// A referência do fornecedor, se houver. Serve para procurar.
  sku  String?

  /// A unidade em que se conta: un, L, kg, par. Texto e não enum pela mesma
  /// razão dos tipos de serviço — quem usa isto tem de poder escrever a dele.
  unit String @default("un")

  /// Para agrupar na tela: Óleos, Filtros, Travões, Pneus.
  category String?

  /// Abaixo disto a tela assinala. Nulo não assinala nunca.
  minQty Decimal? @map("min_qty") @db.Decimal(12, 3)

  /// Quantidade em stock AGORA. Escrita na mesma transação do movimento.
  qty Decimal @default(0) @db.Decimal(12, 3)

  /// Custo médio ponderado por unidade. É este que valoriza as saídas.
  avgCost Decimal @default(0) @map("avg_cost") @db.Decimal(12, 4)

  notes  String?
  /// Desligado em vez de apagado: os movimentos antigos continuam a apontar
  /// para ele, e um consumo de um material que já não existe não diz nada.
  active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  moves StockMove[]

  @@unique([fleetId, name])
  @@index([active])
  @@index([category])
  @@index([fleetId])
  @@map("materials")
}

/// Um movimento de stock: comprei, gastei, ou corrigi a conta.
///
/// ─── OS CUSTOS FICAM GRAVADOS, NÃO SE RECALCULAM ────────────────────────────
///
/// `unitCost` e `totalCost` são escritos no momento e nunca mais mudam. Numa
/// saída, `unitCost` é o custo médio que o material tinha NAQUELE dia — não o
/// de hoje. Sem isso, uma compra caríssima feita amanhã reescrevia o custo de
/// todas as reparações do ano passado, e um relatório impresso em janeiro
/// deixava de bater com o mesmo relatório em março.
model StockMove {
  id         String        @id @default(cuid())

  /// A frota a que isto pertence. Ver `escopo.ts`: nenhuma consulta sai
  /// daqui sem esta coluna preenchida.
  fleetId String @default("") @map("fleet_id")
  materialId String        @map("material_id")
  kind       StockMoveKind

  /// Sempre positiva. O sinal vem do `kind` — o mesmo padrão dos ajustes de
  /// saldo, que já existe neste projeto.
  qty Decimal @db.Decimal(12, 3)

  /// Numa ENTRADA é o preço pago por unidade. Numa SAIDA é o custo médio do
  /// material naquele momento. Num AJUSTE é o mesmo, para a diferença ficar
  /// valorizada.
  unitCost  Decimal? @map("unit_cost")  @db.Decimal(12, 4)
  totalCost Decimal? @map("total_cost") @db.Decimal(12, 2)

  /// Só nas entradas: a quem se comprou e com que factura. É o que permite
  /// ir do consumo de um carro até ao papel.
  supplier   String?
  invoiceRef String? @map("invoice_ref")

  /// Onde foi gasto. Os três são opcionais: compra-se material sem ser para um
  /// carro em particular, e gasta-se material sem haver marcação.
  vehicleId String? @map("vehicle_id")
  bookingId String? @map("booking_id")
  driverId  String? @map("driver_id")

  notes String?

  /// O dia a que o movimento pertence, que pode não ser o dia em que foi
  /// escrito — uma factura de há duas semanas lança-se com a data dela.
  occurredAt DateTime @map("occurred_at")

  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  material  Material @relation(fields: [materialId], references: [id])
  vehicle   Vehicle? @relation("stockMovesForVehicle", fields: [vehicleId], references: [id], onDelete: SetNull)
  booking   Booking? @relation("stockMovesForBooking", fields: [bookingId], references: [id], onDelete: SetNull)
  driver    User?    @relation("stockMovesForDriver", fields: [driverId], references: [id], onDelete: SetNull)
  createdBy User     @relation("stockMovesCreated", fields: [createdById], references: [id])

  @@index([materialId, occurredAt])
  // A pergunta do custo por carro: o que é que foi gasto neste, e quando.
  @@index([vehicleId, occurredAt])
  @@index([bookingId])
  @@index([occurredAt])
  @@index([fleetId])
  @@map("stock_moves")
}


/* =========================
   A PLATAFORMA
   ========================= */

/// Uma frota cliente. É o INQUILINO: tudo o que existe pertence a uma.
///
/// ─── O QUE ISTO MUDA ────────────────────────────────────────────────────────
///
/// Até aqui havia uma frota implícita — a do dono — e nenhuma linha dizia a que
/// frota pertencia. Agora todas dizem, e o âmbito é imposto por `escopo.ts`,
/// que carimba a frota em TODAS as consultas sem ninguém se lembrar.
///
/// ─── PORQUE É QUE O ISOLAMENTO NÃO É UM `where` ESCRITO À MÃO ───────────────
///
/// Porque são cerca de quatrocentas consultas. Uma esquecida não dá erro: dá os
/// motoristas de uma frota a aparecer noutra. Numa casa onde se vendem contas,
/// isso não é um defeito, é o fim do produto.
model Fleet {
  id   String @id @default(cuid())
  name String

  /// Nome curto para endereços e convites. Único no sistema inteiro.
  slug String @unique

  nif   String?
  phone String?
  email String?

  /// Logótipo próprio, mostrado no lugar do nosso dentro da frota dela.
  logoUrl String? @map("logo_url")

  /// Desligada: ninguém dela entra, e os dados ficam. Não se apaga uma frota —
  /// apagar levava anos de fechos e documentos de pessoas reais.
  active Boolean @default(true)

  /// O plano contratado e até quando está pago.
  ///
  /// Nulos os dois quer dizer "sem assinatura": é o estado da frota do próprio
  /// dono, que não paga a ninguém.
  planId             String?   @map("plan_id")
  subscriptionEndsOn DateTime? @map("subscription_ends_on") @db.Date

  /// O que combinaste com esta frota em particular, em texto. O preço do plano
  /// é o do plano; isto é para o resto — descontos, promessas, o que for.
  notes String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  plan     Plan?         @relation(fields: [planId], references: [id], onDelete: SetNull)
  users    User[]
  invites  Invite[]
  requests PlanRequest[]

  @@index([active])
  @@map("fleets")
}

/// Um plano de venda: o que custa, quanto tempo dura, e o que dá acesso.
///
/// ─── OS ACESSOS SÃO AS ÁREAS QUE JÁ EXISTEM ─────────────────────────────────
///
/// `features` é uma lista de áreas — as mesmas de `permissions.catalog.ts`, as
/// que já governam o que cada pessoa da equipa pode abrir. Um plano que dá
/// FLEET e SETTLEMENTS dá à frota os menus da Frota e da Faturação; mais nada
/// aparece, e a API recusa o resto.
///
/// Dois níveis, e nenhum pode ultrapassar o outro: o PLANO diz o que a frota
/// comprou, as PERMISSÕES dizem o que cada pessoa lá dentro pode ver. O acesso
/// real é o cruzamento dos dois. Um gestor com tudo marcado continua sem ver o
/// que o plano dele não inclui.
///
/// Há ainda nomes que não são áreas, para o que se vende e não é um menu — a
/// extensão que automatiza as recolhas é `EXTENSAO`. Ficam na mesma lista de
/// propósito: é uma pergunta só — "isto está incluído?" — e duas listas
/// separadas acabavam a discordar.
model Plan {
  id   String @id @default(cuid())
  name String

  /// Quantos dias dura uma renovação: 30, 90, 180, 365, ou o que escreveres.
  durationDays Int @map("duration_days")

  /// Em euros, por renovação.
  price Decimal @db.Decimal(12, 2)

  /// As áreas e os extras que este plano inclui.
  features String[]

  /// Uma frase para ti, a lembrar a quem se vende isto.
  notes String?

  active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  fleets   Fleet[]
  requests PlanRequest[]

  @@index([active])
  @@map("plans")
}

/// Um convite: o link por onde um motorista entra numa frota.
///
/// ─── PORQUE É QUE O REGISTO ABERTO DEIXOU DE EXISTIR ────────────────────────
///
/// Porque o registo público não diz a que frota pertence quem se inscreve, e
/// não há forma de saber. Com uma frota só, a resposta era óbvia; com várias,
/// qualquer escolha automática punha um motorista dentro da conta de uma
/// empresa que não é a dele — com acesso a um painel que não é o dele. O
/// convite resolve isso levando a frota dentro do próprio link.
///
/// ─── AS TRÊS COLUNAS QUE PARECEM REDUNDANTES E NÃO SÃO ──────────────────────
///
///   - `maxUses`   — o limite que o gestor escreveu. Só para mostrar.
///   - `remaining` — quantos faltam. É ESTA que a trava usa.
///   - `uses`      — quantos já entraram. Só para mostrar.
///
/// Separadas porque a trava tem de ser um único UPDATE atómico: `remaining > 0`
/// compara-se com um número escrito, e por isso o Postgres consegue travar duas
/// pessoas que usem o último lugar ao mesmo tempo. Com `uses < maxUses` seria
/// uma coluna contra outra coluna — que o Prisma sabe fazer, mas obrigava a ler
/// primeiro e a escrever depois, e entre uma coisa e outra cabem os dois.
model Invite {
  id String @id @default(cuid())

  /// A frota a que isto pertence. Ver `escopo.ts`: nenhuma consulta sai
  /// daqui sem esta coluna preenchida.
  fleetId String @default("") @map("fleet_id")

  /// O que vai no link. Único no sistema inteiro: é por ele que se descobre a
  /// frota, antes de haver sessão — tal como o email no login.
  code String @unique

  /// Um nome para o gestor se lembrar do que é este link.
  /// "Grupo do WhatsApp", "Motoristas de outubro".
  label String?

  /// Último dia em que vale, inclusive. Nulo = sem validade.
  expiresOn DateTime? @map("expires_on") @db.Date

  /// O limite escrito pelo gestor. Nulo = sem limite. Só para mostrar.
  maxUses Int? @map("max_uses")

  /// Quantas pessoas ainda pode inscrever. Nulo = sem limite.
  remaining Int? @map("remaining")

  /// Quantas já entraram por aqui.
  uses Int @default(0)

  /// Desligado à mão. Nulo = está de pé. Não se apaga um convite: saber que
  /// alguém entrou por um link cancelado é precisamente o que se quer poder
  /// responder mais tarde.
  revokedAt DateTime? @map("revoked_at")

  /// Quem o criou. Texto e não relação: é para a lista dizer de quem foi, e
  /// uma conta apagada não deve levar o convite atrás.
  createdBy String? @map("created_by")

  createdAt DateTime @default(now()) @map("created_at")

  /// Declarada, ao contrário das outras quarenta tabelas: a página do convite
  /// tem de dizer o nome da frota a quem o abriu, e tem de saber se ela está
  /// ligada — e isso é lido ANTES de haver sessão, num sítio onde uma segunda
  /// consulta era uma segunda oportunidade de a esquecer.
  fleet Fleet @relation(fields: [fleetId], references: [id])

  @@index([fleetId])

  @@map("invites")
}

/// Em que pé está um pedido de plano.
enum PlanRequestStatus {
  OPEN      // à espera de resposta tua
  DONE      // resolvido: o plano foi mudado, ou combinou-se outra coisa
  DISMISSED // não avançou
}

/// Um cliente a pedir um plano melhor.
///
/// ─── PORQUE É QUE NÃO SÃO TICKETS DE SUPORTE ────────────────────────────────
///
/// Porque os tickets são por frota: um ticket aberto na frota do cliente cai na
/// caixa de suporte DELE, que é precisamente quem não o pode resolver. Isto tem
/// de chegar ao dono da plataforma, que está fora daquela frota — e por isso é
/// uma tabela própria, lida em modo de dono.
///
/// ─── PORQUE É QUE NÃO SE APAGA UM PEDIDO ────────────────────────────────────
///
/// Porque é o histórico comercial de uma conta: quem pediu o quê e quando, e o
/// que se combinou. Fecha-se com uma nota e fica. Daqui a um ano, a pergunta
/// "porque é que este cliente está neste preço" tem resposta.
model PlanRequest {
  id String @id @default(cuid())

  /// A frota que pediu. Ver `escopo.ts`.
  fleetId String @default("") @map("fleet_id")

  /// O plano pedido. NULO quer dizer "personalizado": o cliente não quer
  /// nenhum dos que estão à venda e escreveu o que precisa.
  planId String? @map("plan_id")

  /// O que o cliente escreveu, pelas palavras dele.
  message String?

  status PlanRequestStatus @default(OPEN)

  /// Quem pediu, dentro da frota. Texto e não relação: serve para saber com
  /// quem falar, e uma conta apagada não deve levar o pedido atrás.
  requestedBy     String? @map("requested_by")
  requestedByName String? @map("requested_by_name")

  /// A tua nota ao fechar. É isto que responde, daqui a um ano, à pergunta
  /// "o que é que ficou combinado com este cliente".
  resolution String?

  createdAt  DateTime  @default(now()) @map("created_at")
  resolvedAt DateTime? @map("resolved_at")

  /// Declaradas porque a lista do teu painel mostra as duas: de que frota é o
  /// pedido e que plano pediram. Sem elas eram duas consultas a seguir a esta,
  /// e a lista é a primeira coisa que se abre.
  fleet Fleet @relation(fields: [fleetId], references: [id])
  plan  Plan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([fleetId])
  @@index([status])

  @@map("plan_requests")
}

/// De onde veio um contacto, e em que pé está.
enum LeadStatus {
  NOVO
  FALADO    // já houve conversa
  GANHO     // virou motorista ou frota cliente
  PERDIDO
}

enum LeadTipo {
  MOTORISTA
  GESTOR
}

/// Alguém que deixou o contacto no site.
///
/// ─── PORQUE É QUE ISTO NÃO TEM FROTA ────────────────────────────────────────
///
/// Porque ainda não é de nenhuma. É uma pessoa que abriu dragonfleet.pt e
/// deixou o número — não tem conta, não tem sessão, e no caso de um gestor a
/// frota dele ainda não existe. Por isso está em `MODELOS_GLOBAIS` (ver
/// `config/escopo.ts`): é da plataforma, como os planos.
///
/// ─── O QUE ISTO GUARDA, E PORQUE É TÃO POUCO ────────────────────────────────
///
/// Nome, contacto e uma frase. É um formulário público: tudo o que se pedir a
/// mais é uma razão a mais para a pessoa desistir a meio, e é dado pessoal de
/// alguém que ainda não é cliente de ninguém.
model Lead {
  id String @id @default(cuid())

  /// Por que porta entrou: o botão "sou motorista" ou "sou gestor de frota".
  /// Guardado porque muda tudo o que se diz a seguir ao telefone.
  tipo LeadTipo

  name    String
  phone   String
  email   String?
  message String?

  status LeadStatus @default(NOVO)

  /// A tua nota: o que ficou combinado, ou porque não avançou.
  notes String?

  createdAt DateTime  @default(now()) @map("created_at")
  closedAt  DateTime? @map("closed_at")

  @@index([status])
  @@index([createdAt])

  @@map("leads")
}

// ═══════════════════════════════════════════════════════════════════════════
//  FINANÇAS PESSOAIS
// ═══════════════════════════════════════════════════════════════════════════
//
// Só para contas com `personalFinance` ligado. Ver a nota desse campo no
// `User`: é uma marca e não um email escrito numa condição.
//
// ─── O QUE MEXE NO SALDO ────────────────────────────────────────────────────
//
// As despesas saem do saldo, mas não por uma porta nova: cada uma escreve um
// débito em `BalanceAdjustment`, que é a porta que já existe, e é essa linha
// que a vista `driver_balances` desconta. A fórmula do saldo não é tocada —
// já esteve copiada em quatro sítios e uma correção foi aplicada numa cópia e
// esquecida noutra.
//
// O trading não mexe em nada: é estatística e fica isolado.

enum TradeDirection {
  LONG
  SHORT
}

/// Uma operação de trading. Não toca no saldo: existe para dar contas.
model TradeEntry {
  id      String @id @default(cuid())

  /// A frota a que isto pertence. Ver `escopo.ts`: nenhuma consulta sai
  /// daqui sem esta coluna preenchida.
  fleetId String @default("") @map("fleet_id")
  userId  String @map("user_id")

  /// Texto livre: um par de divisas, uma cripto, uma ação, um índice. Uma
  /// lista fechada ficava desactualizada na primeira coisa nova.
  asset     String
  broker    String?
  direction TradeDirection

  openedAt DateTime  @map("opened_at") @db.Date
  /// Nulo enquanto a posição está aberta — que é diferente de ter fechado no
  /// mesmo dia, e um zero não sabe dizer qual das duas.
  closedAt DateTime? @map("closed_at") @db.Date

  /// Contexto da operação, todo opcional. Um formulário que obrigue a oito
  /// campos deixa de ser preenchido ao fim de uma semana, e um diário por
  /// preencher não serve para nada.
  size       Decimal? @db.Decimal(18, 8)
  entryPrice Decimal? @map("entry_price") @db.Decimal(18, 8)
  exitPrice  Decimal? @map("exit_price")  @db.Decimal(18, 8)

  /// O resultado BRUTO em euros, positivo ou negativo. Obrigatório: é o único
  /// campo de que todas as estatísticas dependem.
  ///
  /// Bruto e não líquido, com as comissões à parte, para elas entrarem na
  /// conta em vez de ficarem a enfeitar. E porque o engano possível joga
  /// contra quem escreve — pôr aqui o líquido faz as contas aparecerem mais
  /// baixas do que a realidade, e isso nota-se; o contrário passava despercebido.
  result Decimal @db.Decimal(12, 2)
  fees   Decimal @default(0) @db.Decimal(12, 2)

  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([fleetId])
  @@index([userId, openedAt])
  @@map("trade_entries")
}

/// As gavetas das despesas. São de cada pessoa, e não um catálogo da frota.
model PersonalExpenseCategory {
  id      String @id @default(cuid())
  fleetId String @default("") @map("fleet_id")
  userId  String @map("user_id")

  name      String
  active    Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses PersonalExpense[]

  /// Duas gavetas com o mesmo nome na mesma pessoa tornam os totais por
  /// categoria impossíveis de ler.
  @@unique([userId, name])
  @@index([fleetId])
  @@index([userId])
  @@map("personal_expense_categories")
}

/// Uma despesa pessoal. Sai do saldo, pela porta dos ajustes.
model PersonalExpense {
  id         String  @id @default(cuid())
  fleetId    String  @default("") @map("fleet_id")
  userId     String  @map("user_id")
  categoryId String? @map("category_id")

  /// Sempre positivo. É uma despesa: um valor negativo aqui seria uma receita
  /// disfarçada a somar ao saldo.
  amount  Decimal  @db.Decimal(12, 2)
  spentOn DateTime @map("spent_on") @db.Date
  notes   String?

  /// Opcional, e pode chegar depois do lançamento.
  receiptUrl String? @map("receipt_url")
  receiptKey String? @map("receipt_key")

  /// O débito que esta despesa escreveu no extrato.
  ///
  /// Fica nulo se o ajuste for apagado, em vez de levar a despesa atrás: o
  /// registo pessoal não desaparece porque alguém mexeu no extrato.
  adjustmentId String? @unique @map("adjustment_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user       User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   PersonalExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  adjustment BalanceAdjustment?       @relation(fields: [adjustmentId], references: [id], onDelete: SetNull)
  movements  StatementMovement[]

  @@index([fleetId])
  @@index([userId, spentOn])
  @@index([categoryId])
  @@map("personal_expenses")
}

/// Um crédito. Guarda-se o contrato; tudo o resto calcula-se — ver `creditos.ts`.
model Credit {
  id      String @id @default(cuid())
  fleetId String @default("") @map("fleet_id")
  userId  String @map("user_id")

  name   String
  /// A quem se deve. Texto livre: há créditos que não são de bancos.
  lender String?

  principal Decimal @db.Decimal(12, 2)

  /// A primeira prestação. As seguintes andam de mês a mês a partir daqui —
  /// a data do fim NÃO se guarda, calcula-se, e assim nunca pode ficar em
  /// desacordo com o número de prestações.
  startedOn    DateTime @map("started_on") @db.Date
  installments Int

  /// A prestação que sai de facto todos os meses.
  ///
  /// Guardada apesar de se poder calcular: é o número que ele sabe de cor, e
  /// é com ele que se confere se o resto foi bem copiado do contrato. Um
  /// dígito trocado no capital dá um quadro inteiro errado, bonito e coerente
  /// consigo próprio — e esta é a única coisa que o denuncia.
  monthlyPayment Decimal? @map("monthly_payment") @db.Decimal(12, 2)

  /// Corre sobre o capital em dívida. A ÚNICA que entra no quadro.
  ///
  /// OPCIONAL: há créditos que não são de bancos — investidores particulares,
  /// com condições próprias e às vezes sem juros nenhuns. Num contrato desses
  /// não há TAN, e um zero não distingue «sem juros» de «não preenchi».
  tan  Decimal? @db.Decimal(6, 3)

  /// O que se devolve ao todo. É a alternativa à taxa: a diferença para o
  /// capital É o juro, sem taxa nenhuma de permeio. Ver `plano.ts`.
  totalToPay Decimal? @map("total_to_pay") @db.Decimal(12, 2)
  /// Inclui comissões, seguros e imposto de selo. Para comparar propostas.
  taeg Decimal? @db.Decimal(6, 3)
  /// O total que se acaba por entregar, lido do contrato. Não se calcula.
  mtic Decimal? @db.Decimal(12, 2)

  notes String?

  /// Liquidado antes do fim. Nulo é o caso normal: ainda está a correr.
  closedOn DateTime? @map("closed_on") @db.Date

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tranches CreditTranche[]
  payments CreditPayment[]

  @@index([fleetId])
  @@index([userId, startedOn])
  @@map("credits")
}

// ═══════════════════════════════════════════════════════════════════════════
//  AS CONTAS DA EMPRESA
// ═══════════════════════════════════════════════════════════════════════════
//
// O que falta ao sistema para responder a duas perguntas diferentes:
//
//   «O negócio dá dinheiro?»   → lucro = receita da frota − despesas daqui
//   «Tenho dinheiro na conta?» → caixa = saldo declarado − o que é dos motoristas
//
// O pagamento a um motorista NÃO se lança aqui: o que é dele nunca foi receita
// da empresa, e descontá-lo outra vez contava-o duas vezes. Ver a nota longa
// em `src/modules/company/lucro.ts`.

/// O plano de contas da empresa. Da frota, e não de uma pessoa.
model CompanyExpenseCategory {
  id      String @id @default(cuid())
  fleetId String @default("") @map("fleet_id")

  name      String
  active    Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  expenses CompanyExpense[]

  @@unique([fleetId, name])
  @@index([fleetId])
  @@map("company_expense_categories")
}

/// Uma despesa da empresa. Desconta ao lucro, não ao saldo de ninguém.
model CompanyExpense {
  id         String  @id @default(cuid())
  fleetId    String  @default("") @map("fleet_id")
  categoryId String? @map("category_id")

  /// Sempre positivo. Um valor negativo seria uma receita disfarçada a somar
  /// ao lucro — e a base recusa-o.
  amount   Decimal  @db.Decimal(12, 2)
  spentOn  DateTime @map("spent_on") @db.Date
  supplier String?
  notes    String?

  /// Opcional, e pode chegar depois do lançamento.
  receiptUrl String? @map("receipt_url")
  receiptKey String? @map("receipt_key")

  createdById String? @map("created_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  category  CompanyExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy User?                   @relation("companyExpensesCreated", fields: [createdById], references: [id], onDelete: SetNull)
  movements StatementMovement[]

  @@index([fleetId, spentOn])
  @@index([categoryId])
  @@map("company_expenses")
}

/// O saldo da conta bancária, declarado num dia.
///
/// Declarado e não calculado: a aplicação não vê o banco. As prestações dos
/// créditos saem por débito direto e as despesas pagas com o cartão pessoal
/// entram por outro lado — um saldo calculado só com o que a aplicação
/// conhece estaria sempre errado, e errado para MAIS.
///
/// Guarda-se o histórico e não só o último: com histórico vê-se a evolução da
/// conta e apanha-se uma declaração enganada; com um valor só, um engano apaga
/// o anterior e não há a que voltar.
model CompanyCashMark {
  id      String @id @default(cuid())
  fleetId String @default("") @map("fleet_id")

  /// Pode ser negativo: uma conta a descoberto é um estado possível, e travá-lo
  /// a zero escondia precisamente a situação que é preciso ver.
  balance    Decimal  @db.Decimal(12, 2)
  observedOn DateTime @map("observed_on") @db.Date
  notes      String?

  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  createdBy User? @relation("cashMarksCreated", fields: [createdById], references: [id], onDelete: SetNull)

  /// Uma declaração por dia: duas no mesmo dia e deixa de haver resposta para
  /// «qual era o saldo nesse dia».
  @@unique([fleetId, observedOn])
  @@index([fleetId, observedOn])
  @@map("company_cash_marks")
}

/// Qual linha do fecho é que o motorista está a pôr em causa.
///
/// Um enum e não texto livre: é por este campo que se agrupa («a Via Verde é
/// metade dos pedidos») e que se impede o mesmo pedido duas vezes. Texto livre
/// dava «via verde», «Via-Verde» e «viaverde» como três coisas diferentes.
enum SettlementLine {
  VIA_VERDE
  COMBUSTIVEL
  CARREGAMENTO
  VIATURA
  OUTRAS_DEDUCOES
  IMPOSTO
  COMISSAO
  UBER
  BOLT
  OUTRA
}

enum SettlementQueryStatus {
  ABERTO
  RESPONDIDO
}

/// Um pedido de esclarecimento sobre uma linha do fecho semanal.
///
/// ─── O PROBLEMA QUE ISTO RESOLVE ────────────────────────────────────────────
///
/// Um motorista olha para o fecho, vê «Via Verde − 14,45 €» e acha estranho.
/// Hoje a conversa acontece no WhatsApp: ele pergunta, alguém vai buscar o
/// extrato, manda uma fotografia, e passadas duas semanas ninguém se lembra do
/// que foi dito nem onde ficou o ficheiro. Da próxima vez, repete-se tudo.
///
/// Com isto o pedido fica registado, a resposta fica agarrada àquela semana, e
/// quem perguntar outra vez encontra lá o extrato.
///
/// ─── PORQUE É QUE SERVE QUALQUER LINHA ──────────────────────────────────────
///
/// Porque o combustível levanta exactamente a mesma dúvida, e o aluguer e o
/// imposto também. O dia em que alguém duvidar de outra coisa não precisa de
/// uma migração nova.
model SettlementQuery {
  id String @id @default(cuid())

  /// A frota a que isto pertence. Ver `escopo.ts`: nenhuma consulta sai
  /// daqui sem esta coluna preenchida.
  fleetId      String @default("") @map("fleet_id")
  settlementId String @map("settlement_id")

  /// Quem perguntou. O fecho já diz de quem é, mas guarda-se na mesma: é por
  /// esta coluna que o motorista encontra os pedidos DELE sem ter de passar
  /// pelos fechos todos.
  userId String @map("user_id")

  line SettlementLine

  /// O que ele escreveu, se escreveu. Opcional de propósito: obrigar a
  /// justificar uma dúvida é a melhor maneira de ninguém a levantar.
  reason String?

  status SettlementQueryStatus @default(ABERTO)

  /// A resposta e o extrato anexado. O ficheiro é opcional: há dúvidas que se
  /// esclarecem com uma frase, e exigir um anexo só obrigava a inventar um.
  answer     String?
  fileUrl    String? @map("file_url")
  fileKey    String? @map("file_key")
  answeredAt DateTime? @map("answered_at")

  /// Quem respondeu. Opcional porque a conta pode sair da empresa e a resposta
  /// tem de ficar — fica sem autor, que é muito melhor do que desaparecer.
  answeredById String? @map("answered_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  settlement WeeklySettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  user       User             @relation("queriesAsked", fields: [userId], references: [id], onDelete: Cascade)
  answeredBy User?            @relation("queriesAnswered", fields: [answeredById], references: [id], onDelete: SetNull)

  /// ATENÇÃO: há um índice único PARCIAL na base que o Prisma não sabe
  /// escrever — `settlement_queries_abertos_key` em (settlement_id, line)
  /// WHERE status = 'ABERTO'. É ele que impede dois pedidos abertos sobre a
  /// mesma linha e deixa na mesma voltar a perguntar depois de respondido.
  /// Não o troques por um `@@unique([settlementId, line])`: esse fechava a
  /// segunda porta para sempre. Ver a migração `20261014200000`.
  @@index([fleetId])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("settlement_queries")
}


/// De que banco é a conta. Igual aos leitores em `modules/extratos`.
enum BankCode {
  ABANCA
  NOVO_BANCO
  MILLENNIUM
  REVOLUT
  REVOLUT_BUSINESS
}

/// De quem é a conta: dele ou da empresa.
enum BankScope {
  PESSOAL
  EMPRESA
}

enum MovementClass {
  DESPESA
  RECEITA
  TRANSFERENCIA
}

/// Uma conta bancária de onde se importam extratos.
model StatementAccount {
  id      String @id @default(cuid())
  fleetId String @default("") @map("fleet_id")

  bank  BankCode
  scope BankScope

  /// Os QUATRO ÚLTIMOS dígitos do IBAN, e mais nada — ver a nota longa na
  /// migração. Chegam para reconhecer a conta e para não misturar duas do
  /// mesmo banco, que é tudo para o que isto serve.
  tail  String
  label String

  /// A quem pertence, nas contas pessoais. Nulo nas da empresa.
  ownerId String? @map("owner_id")

  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  owner      User?           @relation("statementAccountOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  statements StatementFile[]
  movements  StatementMovement[]

  @@unique([fleetId, bank, tail])
  @@index([fleetId, scope])
  @@index([ownerId])
  @@map("statement_accounts")
}

/// Um ficheiro de extrato que foi importado.
model StatementFile {
  id        String @id @default(cuid())
  fleetId   String @default("") @map("fleet_id")
  accountId String @map("account_id")

  periodStart DateTime? @map("period_start") @db.Date
  periodEnd   DateTime? @map("period_end")   @db.Date

  openingBalance Decimal? @map("opening_balance") @db.Decimal(12, 2)
  closingBalance Decimal? @map("closing_balance") @db.Decimal(12, 2)

  fileName String? @map("file_name")
  fileUrl  String? @map("file_url")
  fileKey  String? @map("file_key")

  /// SHA-256 do PDF. É o que impede importar o mesmo extrato duas vezes —
  /// o engano mais fácil de cometer e o mais difícil de ver depois, porque
  /// os movimentos repetidos parecem todos legítimos.
  fileHash String @map("file_hash")

  importedById String?  @map("imported_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  account    StatementAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  importedBy User?          @relation("statementsImported", fields: [importedById], references: [id], onDelete: SetNull)
  movements  StatementMovement[]

  @@unique([fleetId, fileHash])
  @@index([accountId, periodStart])
  @@map("statement_files")
}

/// Uma linha do extrato.
///
/// ─── OS PONTEIROS PARA AS DESPESAS ──────────────────────────────────────────
///
/// Um movimento não guarda uma segunda cópia da despesa: quando passa a
/// contar, CRIA a linha em `company_expenses` ou `personal_expenses` e guarda
/// aqui o ponteiro. O lucro e o saldo continuam a ler as tabelas de sempre,
/// que já estão testadas — uma segunda fonte para os mesmos números acabaria
/// por divergir da primeira.
model StatementMovement {
  id          String @id @default(cuid())
  fleetId     String @default("") @map("fleet_id")
  statementId String @map("statement_id")
  accountId   String @map("account_id")

  /// A data VALOR: é a que decide em que mês o movimento entra.
  occurredOn DateTime  @map("occurred_on") @db.Date
  bookedOn   DateTime? @map("booked_on")   @db.Date

  description String

  /// Negativo saiu, positivo entrou.
  amount Decimal @db.Decimal(12, 2)
  /// O saldo impresso pelo banco. É a prova contra a qual a importação se
  /// verificou, e com a qual se volta a verificar um dia.
  balance Decimal? @db.Decimal(12, 2)

  reference String?
  class     MovementClass
  position  Int @default(0)

  companyExpenseId  String? @map("company_expense_id")
  personalExpenseId String? @map("personal_expense_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  statement       StatementFile    @relation(fields: [statementId], references: [id], onDelete: Cascade)
  account         StatementAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  companyExpense  CompanyExpense?  @relation(fields: [companyExpenseId], references: [id], onDelete: SetNull)
  personalExpense PersonalExpense? @relation(fields: [personalExpenseId], references: [id], onDelete: SetNull)

  @@index([statementId, position])
  @@index([accountId, occurredOn])
  @@index([fleetId, occurredOn])
  @@map("statement_movements")
}


/// Um tramo de prestações: «a partir da N.ª, passa a ser X».
///
/// Guarda o INÍCIO e não o intervalo. Com intervalos (1–12, 13–24) é possível
/// deixar um buraco ou sobrepor dois, e aí não há resposta para «quanto é a
/// prestação 13». Com o início só, cada prestação cai sempre em exactamente um
/// tramo.
model CreditTranche {
  id       String @id @default(cuid())
  fleetId  String @default("") @map("fleet_id")
  creditId String @map("credit_id")

  fromInstallment Int     @map("from_installment")
  amount          Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at")

  credit Credit @relation(fields: [creditId], references: [id], onDelete: Cascade)

  @@unique([creditId, fromInstallment])
  @@index([creditId, fromInstallment])
  @@map("credit_tranches")
}

/// Uma prestação paga de facto.
///
/// Existe porque contar pelos meses decorridos assume que se pagou sempre a
/// horas — e um dos créditos dele tem uma prestação em atraso. Contado pela
/// data, um crédito em incumprimento aparecia como se estivesse em dia.
model CreditPayment {
  id       String @id @default(cuid())
  fleetId  String @default("") @map("fleet_id")
  creditId String @map("credit_id")

  paidOn DateTime @map("paid_on") @db.Date
  amount Decimal  @db.Decimal(12, 2)
  notes  String?

  createdAt DateTime @default(now()) @map("created_at")

  credit Credit @relation(fields: [creditId], references: [id], onDelete: Cascade)

  @@index([creditId, paidOn])
  @@index([fleetId, paidOn])
  @@map("credit_payments")
}
