{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    // O vite.config.ts corre em Node: usa `path` e `__dirname`, que não
    // existem sem estes tipos. Sem eles o typecheck falhava no próprio
    // ficheiro de configuração.
    "types": ["node"]
  },
  "include": ["vite.config.ts"]
}
